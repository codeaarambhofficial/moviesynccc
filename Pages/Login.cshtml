@page
@model MovieSync.Web.Pages.LoginModel
@{
    ViewData["Title"] = "MovieSync - Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            background-color: #f8f9fa;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            font-family: Arial, Helvetica, sans-serif;
            margin: 0;
        }
        .top-navbar {
            padding: 20px 40px;
            display: flex;
            align-items: center;
        }
        .brand-logo {
            color: #6f42c1;
            font-size: 1.2rem;
            font-weight: 600;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .main-container {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }
        .login-card {
            width: 100%;
            max-width: 480px;
            background: white;
            border-radius: 12px;
            padding: 45px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
            border: 1px solid #eaeaea;
        }
        .icon-circle {
            width: 50px;
            height: 50px;
            background: #f3eafd;
            color: #6f42c1;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px auto;
            font-size: 1.25rem;
        }
        .form-control {
            height: 48px;
            border-radius: 8px;
            border: 1px solid #dee2e6;
            padding-left: 40px;
            font-size: 0.95rem;
        }
        .form-control:focus {
            box-shadow: none;
            border-color: #6f42c1;
        }
        .input-icon-wrap {
            position: relative;
        }
        .input-icon-wrap i {
            position: absolute;
            left: 15px;
            top: 16px;
            color: #6c757d;
        }
        .btn-signin {
            background-color: #6f42c1;
            border-color: #6f42c1;
            color: white;
            height: 48px;
            border-radius: 8px;
            font-weight: 500;
        }
        .btn-signin:hover {
            background-color: #5d35a7;
            border-color: #5d35a7;
            color: white;
        }
        .btn-register {
            background-color: white;
            border: 1px solid #dee2e6;
            color: #333;
            height: 48px;
            border-radius: 8px;
            font-weight: 500;
        }
        .btn-register:hover {
            background-color: #f8f9fa;
        }
        .btn-google {
            background-color: #dc3545;
            border-color: #dc3545;
            color: white;
            height: 48px;
            border-radius: 8px;
            font-weight: 500;
        }
        .btn-google:hover {
            background-color: #bb2d3b;
            border-color: #b02a37;
            color: white;
        }
        .divider-text {
            text-align: center;
            position: relative;
            margin: 20px 0;
        }
        .divider-text::before {
            content: "";
            position: absolute;
            top: 50%;
            left: 0;
            width: 100%;
            height: 1px;
            background: #eaeaea;
        }
        .divider-text span {
            background: white;
            padding: 0 15px;
            position: relative;
            color: #6c757d;
            font-size: 0.85rem;
        }
    </style>
</head>
<body>

<div class="top-navbar">
    <a href="#" class="brand-logo">
        <i class="fa-solid fa-film"></i> MovieSync
    </a>
</div>

<div class="main-container">
    <div class="login-card">
        <div class="icon-circle">
            <i class="fa-solid fa-film"></i>
        </div>
        
        <h2 class="text-center fw-bold mb-1" style="font-size: 1.6rem; color: #212529;">MovieSync</h2>
        <p class="text-center text-muted mb-4" style="font-size: 0.9rem;">Watch together in real-time</p>

        <div id="error-alert" class="alert alert-danger d-none py-2 mb-3" role="alert" style="font-size: 0.9rem;"></div>

        <div class="mb-3">
            <label class="form-label text-muted small fw-bold">Email Address</label>
            <div class="input-icon-wrap">
                <i class="fa-regular fa-envelope"></i>
                <input id="email" type="email" class="form-control" placeholder="roshni@gmail.com" />
            </div>
        </div>

        <div class="mb-4">
            <label class="form-label text-muted small fw-bold">Password</label>
            <div class="input-icon-wrap">
                <i class="fa-solid fa-lock"></i>
                <input id="password" type="password" class="form-control" placeholder="********" />
            </div>
        </div>

        <button id="login-btn" type="button" class="btn btn-signin w-100 mb-3 shadow-sm">
            <i class="fa-solid fa-right-to-bracket me-2"></i>Sign In
        </button>

        <div class="divider-text">
            <span>New to MovieSync?</span>
        </div>

        <button id="register-btn" type="button" class="btn btn-register w-100 mb-3">
            <i class="fa-solid fa-user-plus me-2"></i>Register Account
        </button>

        <button id="google-login-btn" type="button" class="btn btn-google w-100 shadow-sm">
            <i class="fa-brands fa-google me-2"></i>Continue with Google
        </button>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
import { getAuth, signInWithEmailAndPassword, createUserWithEmailAndPassword, GoogleAuthProvider, signInWithPopup } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";

const firebaseConfig = {
    apiKey: "AIzaSyCssJy7q2tdMSnHJ8xfj5Hl5HUqO1TKcrw",
    authDomain: "moviesync-9bcef.firebaseapp.com",
    projectId: "moviesync-9bcef",
    storageBucket: "moviesync-9bcef.firebasestorage.app",
    messagingSenderId: "883297078524",
    appId: "1:883297078524:web:370bcd6b038e5191da5b79"
};

const app = initializeApp(firebaseConfig);
const auth = getAuth(app);

async function handleAuth(actionType) {
    const email = document.getElementById('email').value.trim();
    const password = document.getElementById('password').value.trim();
    const alertBox = document.getElementById('error-alert');
    const loginBtn = document.getElementById('login-btn');
    const registerBtn = document.getElementById('register-btn');

    if (!email || !password) {
        alertBox.textContent = "Please enter both email and password.";
        alertBox.classList.remove('d-none');
        return;
    }

    alertBox.classList.add('d-none');
    const loginText = loginBtn.innerHTML;
    const registerText = registerBtn.innerHTML;

    if (actionType === "login") {
        loginBtn.disabled = true;
        loginBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span>Signing In...`;
    } else {
        registerBtn.disabled = true;
        registerBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span>Registering...`;
    }

    try {
        let userCredential;
        if (actionType === "login") {
            userCredential = await signInWithEmailAndPassword(auth, email, password);
        } else {
            userCredential = await createUserWithEmailAndPassword(auth, email, password);
        }

        // Get Firebase ID Token
        const idToken = await userCredential.user.getIdToken();

        // Send token to backend API endpoint
        const response = await fetch(`/api/auth/login`, {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({ idToken })
        });

        if (response.ok) {
            redirectToRoom();
        } else {
            const data = await response.json();
            alertBox.textContent = data.message || "Authentication failed.";
            alertBox.classList.remove("d-none");
        }
    } catch (err) {
        alertBox.textContent = err.message || "Unable to connect to the server.";
        alertBox.classList.remove("d-none");
    } finally {
        loginBtn.disabled = false;
        registerBtn.disabled = false;
        loginBtn.innerHTML = loginText;
        registerBtn.innerHTML = registerText;
    }
}

function redirectToRoom() {
    const params = new URLSearchParams(window.location.search);
    const roomId = params.get("roomId");
    if (roomId) {
        window.location.href = `/Room?roomId=${encodeURIComponent(roomId)}`;
    } else {
        window.location.href = "/Room";
    }
}

document.getElementById("login-btn").addEventListener("click", () => handleAuth("login"));
document.getElementById("register-btn").addEventListener("click", () => handleAuth("register"));
document.getElementById("password").addEventListener("keypress", function(e) {
    if (e.key === "Enter") handleAuth("login");
});

document.getElementById("google-login-btn").addEventListener("click", async () => {
    try {
        const provider = new GoogleAuthProvider();
        const result = await signInWithPopup(auth, provider);
        const idToken = await result.user.getIdToken();

        await fetch(`/api/auth/login`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ idToken })
        });

        redirectToRoom();
    } catch (err) {
        const alertBox = document.getElementById("error-alert");
        alertBox.textContent = err.message;
        alertBox.classList.remove("d-none");
    }
});
</script>

</body>
</html>