@page
@model MovieSync.Web.Pages.LoginModel
@{
    ViewData["Title"] = "MovieSync - Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <!-- Favicon / Title Logo -->
    <link rel="icon" type="image/png" href="https://iili.io/CUd6N4f.md.png" />
    <link rel="shortcut icon" type="image/png" href="https://iili.io/CUd6N4f.md.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body, input, button, select, textarea {
            font-family: 'Space Grotesk', system-ui, -apple-system, sans-serif !important;
        }
        body {
            background-color: #090d16;
            color: #f8fafc;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            margin: 0;
        }
        .top-navbar {
            padding: 16px 36px;
            display: flex;
            align-items: center;
            border-bottom: 1px solid #1e293b;
            background: #073F78;
        }
        .brand-logo {
            color: #ffffff;
            font-size: 1.35rem;
            font-weight: 700;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
            letter-spacing: -0.02em;
        }
        .main-container {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 30px 20px;
            background-color: #090d16;
        }
        .login-card {
            width: 100%;
            max-width: 440px;
            background: #0e1726;
            border-radius: 16px;
            padding: 40px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
            border: 1px solid #1e293b;
            color: #ffffff;
        }
        .form-control {
            height: 48px;
            border-radius: 10px;
            background-color: #162032 !important;
            border: 1px solid #28364f !important;
            color: #ffffff !important;
            padding-left: 42px;
            font-size: 0.95rem;
        }
        .form-control::placeholder {
            color: #64748b !important;
        }
        .form-control:focus {
            box-shadow: 0 0 0 2px rgba(239, 0, 57, 0.4) !important;
            border-color: #EF0039 !important;
        }
        .input-icon-wrap {
            position: relative;
        }
        .input-icon-wrap i {
            position: absolute;
            left: 14px;
            top: 16px;
            color: #94a3b8;
        }
        .btn-signin {
            background-color: #EF0039;
            border: none;
            color: #ffffff !important;
            height: 48px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.2s ease;
        }
        .btn-signin:hover {
            background-color: #d00032;
            color: #ffffff !important;
            transform: translateY(-1px);
        }
        .btn-register {
            background-color: #073F78;
            border: 1px solid #073F78;
            color: #ffffff !important;
            height: 48px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.2s ease;
        }
        .btn-register:hover {
            background-color: #052e59;
            color: #ffffff !important;
            transform: translateY(-1px);
        }
        .btn-google {
            background-color: #111827;
            border: 1px solid #374151;
            color: #ffffff !important;
            height: 48px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.98rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: all 0.2s ease;
        }
        .btn-google:hover {
            background-color: #1f2937;
            border-color: #4b5563;
            color: #ffffff !important;
            transform: translateY(-1px);
        }
        .divider-text {
            text-align: center;
            position: relative;
            margin: 24px 0;
        }
        .divider-text::before {
            content: "";
            position: absolute;
            top: 50%;
            left: 0;
            width: 100%;
            height: 1px;
            background: #1e293b;
        }
        .divider-text span {
            background: #0e1726;
            padding: 0 12px;
            position: relative;
            color: #94a3b8;
            font-size: 0.88rem;
            font-weight: 500;
        }
    </style>
</head>
<body>

<div class="top-navbar">
    <a href="#" class="brand-logo">
        <img src="https://iili.io/CUdicRp.png" alt="MovieSync" style="height: 32px; width: auto; object-fit: contain;" /> MovieSync
    </a>
</div>

<div class="main-container">
    <div class="login-card">
        <div class="text-center mb-3">
            <img src="https://iili.io/CUdicRp.png" alt="MovieSync Logo" style="height: 64px; width: auto; object-fit: contain;" />
        </div>
        
        <h2 class="text-center fw-bold mb-1" style="font-size: 1.65rem; color: #ffffff;">MovieSync</h2>
        <p class="text-center mb-4" style="font-size: 0.92rem; color: #cbd5e1;">Watch together in real-time</p>

        <div id="error-alert" class="alert alert-danger d-none py-2 mb-3" role="alert" style="font-size: 0.9rem;"></div>

        <div class="mb-3">
            <label class="form-label small fw-bold" style="color: #e2e8f0;">Email Address</label>
            <div class="input-icon-wrap">
                <i class="fa-regular fa-envelope"></i>
                <input id="email" type="email" class="form-control" placeholder="roshni@gmail.com" />
            </div>
        </div>

        <div class="mb-4">
            <label class="form-label small fw-bold" style="color: #e2e8f0;">Password</label>
            <div class="input-icon-wrap">
                <i class="fa-solid fa-lock"></i>
                <input id="password" type="password" class="form-control" placeholder="********" />
            </div>
        </div>

        <button id="login-btn" type="button" class="btn btn-signin w-100 mb-3 shadow-sm">
            <i class="fa-solid fa-right-to-bracket me-2"></i>Sign In
        </button>

        <div class="divider-text">
            <span>New to MovieSync?</span>
        </div>

        <button id="register-btn" type="button" class="btn btn-register w-100 mb-3">
            <i class="fa-solid fa-user-plus me-2"></i>Register Account
        </button>

        <button id="google-login-btn" type="button" class="btn btn-google w-100 shadow-sm">
            <svg width="20" height="20" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
                <path d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844a4.14 4.14 0 0 1-1.796 2.716v2.259h2.908c1.702-1.567 2.684-3.875 2.684-6.616z" fill="#4285F4"/>
                <path d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z" fill="#34A853"/>
                <path d="M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332z" fill="#FBBC05"/>
                <path d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z" fill="#EA4335"/>
            </svg>
            <span style="color: #ffffff; font-weight: 600;">Continue with Google</span>
        </button>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
import { getAuth, signInWithEmailAndPassword, createUserWithEmailAndPassword, GoogleAuthProvider, signInWithPopup, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";

const firebaseConfig = {
    apiKey: "AIzaSyCssJy7q2tdMSnHJ8xfj5Hl5HUqO1TKcrw",
    authDomain: "moviesync-9bcef.firebaseapp.com",
    projectId: "moviesync-9bcef",
    storageBucket: "moviesync-9bcef.firebasestorage.app",
    messagingSenderId: "883297078524",
    appId: "1:883297078524:web:370bcd6b038e5191da5b79"
};

const app = initializeApp(firebaseConfig);
const auth = getAuth(app);

// Auto check existing session on page load
onAuthStateChanged(auth, async (user) => {
    if (user) {
        try {
            const idToken = await user.getIdToken();
            const response = await fetch(`/api/auth/login`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ idToken })
            });
            if (response.ok) {
                redirectToRoom();
            }
        } catch (e) {
            console.warn("Auto-login token refresh:", e);
        }
    }
});

async function handleAuth(actionType) {
    const email = document.getElementById('email').value.trim();
    const password = document.getElementById('password').value.trim();
    const alertBox = document.getElementById('error-alert');
    const loginBtn = document.getElementById('login-btn');
    const registerBtn = document.getElementById('register-btn');

    if (!email || !password) {
        alertBox.textContent = "Please enter both email and password.";
        alertBox.classList.remove('d-none');
        return;
    }

    alertBox.classList.add('d-none');
    const loginText = loginBtn.innerHTML;
    const registerText = registerBtn.innerHTML;

    if (actionType === "login") {
        loginBtn.disabled = true;
        loginBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span>Signing In...`;
    } else {
        registerBtn.disabled = true;
        registerBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span>Registering...`;
    }

    try {
        let userCredential;
        if (actionType === "login") {
            userCredential = await signInWithEmailAndPassword(auth, email, password);
        } else {
            userCredential = await createUserWithEmailAndPassword(auth, email, password);
        }

        // Get Firebase ID Token
        const idToken = await userCredential.user.getIdToken();

        // Send token to backend API endpoint
        const response = await fetch(`/api/auth/login`, {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({ idToken })
        });

        if (response.ok) {
            redirectToRoom();
        } else {
            const data = await response.json();
            alertBox.textContent = data.message || "Authentication failed.";
            alertBox.classList.remove("d-none");
        }
    } catch (err) {
        alertBox.textContent = err.message || "Unable to connect to the server.";
        alertBox.classList.remove("d-none");
    } finally {
        loginBtn.disabled = false;
        registerBtn.disabled = false;
        loginBtn.innerHTML = loginText;
        registerBtn.innerHTML = registerText;
    }
}

function redirectToRoom() {
    const params = new URLSearchParams(window.location.search);
    const roomId = params.get("roomId");
    if (roomId) {
        window.location.href = `/Room?roomId=${encodeURIComponent(roomId)}`;
    } else {
        window.location.href = "/Room";
    }
}

document.getElementById("login-btn").addEventListener("click", () => handleAuth("login"));
document.getElementById("register-btn").addEventListener("click", () => handleAuth("register"));
document.getElementById("password").addEventListener("keypress", function(e) {
    if (e.key === "Enter") handleAuth("login");
});

document.getElementById("google-login-btn").addEventListener("click", async () => {
    try {
        const provider = new GoogleAuthProvider();
        const result = await signInWithPopup(auth, provider);
        const idToken = await result.user.getIdToken();

        await fetch(`/api/auth/login`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ idToken })
        });

        redirectToRoom();
    } catch (err) {
        const alertBox = document.getElementById("error-alert");
        alertBox.textContent = err.message;
        alertBox.classList.remove("d-none");
    }
});
</script>

</body>
</html>