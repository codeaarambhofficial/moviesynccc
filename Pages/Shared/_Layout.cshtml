<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MovieSync</title>
    
    <!-- Favicon / Title Logo -->
    <link rel="icon" type="image/png" href="https://iili.io/CUd6N4f.md.png" />
    <link rel="shortcut icon" type="image/png" href="https://iili.io/CUd6N4f.md.png" />
    
    <!-- Google Fonts: Space Grotesk -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap CSS, FontAwesome & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    
    <!-- Custom Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MovieSync.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-md navbar-dark custom-navbar py-3 border-bottom border-light border-opacity-10">
            <div class="container-fluid px-4">
                <a class="navbar-brand d-flex align-items-center gap-2" href="/Room">
                    <img src="https://iili.io/CUdicRp.png" alt="MovieSync" style="height: 34px; width: auto; object-fit: contain;" />
                    <span class="fw-bold tracking-tight text-white fs-4">MovieSync</span>
                </a>
                
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarContent">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-md-0 ms-md-3">
                            <li class="nav-item">
                                <a class="nav-link px-3 active d-flex align-items-center gap-2" href="/Room">
                                    <i class="bi bi-play-circle-fill"></i> Watch Room
                                </a>
                            </li>
                        </ul>
                        <div class="d-flex align-items-center ms-auto gap-3">
                            <span class="user-badge px-3 py-1.5 rounded-pill d-flex align-items-center gap-2">
                                <i class="bi bi-person-circle text-primary"></i>
                                <span class="small fw-semibold">@User.Identity.Name?.Split('@')[0]</span>
                            </span>
                            
                            <button class="btn btn-logout d-flex align-items-center gap-2 px-3 py-1.5 rounded-pill" onclick="logoutUser()">
                                <i class="bi bi-box-arrow-right"></i> Logout
                            </button>
                            
                            <div class="dropdown">
                                <button class="btn btn-glass btn-sm rounded-pill dropdown-toggle d-flex align-items-center gap-2 px-3 py-1.5" type="button" id="themeDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-palette-fill" id="theme-icon"></i>
                                    <span class="d-none d-md-inline small fw-semibold" id="theme-label">Theme</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end glass-panel shadow-lg border border-light border-opacity-10 py-2" aria-labelledby="themeDropdown">
                                    <li>
                                        <button class="dropdown-item d-flex align-items-center gap-2 py-2 px-3 cursor-pointer text-light" onclick="setAppTheme('dark')">
                                            <i class="bi bi-moon-stars-fill text-warning"></i>
                                            <span class="small fw-medium">Midnight Dark</span>
                                        </button>
                                    </li>
                                    <li>
                                        <button class="dropdown-item d-flex align-items-center gap-2 py-2 px-3 cursor-pointer text-light" onclick="setAppTheme('light')">
                                            <i class="bi bi-sun-fill text-warning"></i>
                                            <span class="small fw-medium">Clean Light</span>
                                        </button>
                                    </li>
                                    <li>
                                        <button class="dropdown-item d-flex align-items-center gap-2 py-2 px-3 cursor-pointer text-light" onclick="setAppTheme('mint-dark')">
                                            <i class="bi bi-droplet-fill text-info"></i>
                                            <span class="small fw-medium">Cyber Teal</span>
                                        </button>
                                    </li>
                                    <li>
                                        <button class="dropdown-item d-flex align-items-center gap-2 py-2 px-3 cursor-pointer text-light" onclick="setAppTheme('emerald')">
                                            <i class="bi bi-gem text-emerald"></i>
                                            <span class="small fw-medium">Emerald Glow</span>
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center ms-auto">
                            <div class="dropdown">
                                <button class="btn btn-glass btn-sm rounded-pill dropdown-toggle d-flex align-items-center gap-2 px-3 py-1.5" type="button" id="themeDropdownGuest" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-palette-fill" id="theme-icon"></i>
                                    <span class="d-none d-md-inline small fw-semibold" id="theme-label">Theme</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end glass-panel shadow-lg border border-light border-opacity-10 py-2" aria-labelledby="themeDropdownGuest">
                                    <li>
                                        <button class="dropdown-item d-flex align-items-center gap-2 py-2 px-3 cursor-pointer text-light" onclick="setAppTheme('dark')">
                                            <i class="bi bi-moon-stars-fill text-warning"></i>
                                            <span class="small fw-medium">Midnight Dark</span>
                                        </button>
                                    </li>
                                    <li>
                                        <button class="dropdown-item d-flex align-items-center gap-2 py-2 px-3 cursor-pointer text-light" onclick="setAppTheme('light')">
                                            <i class="bi bi-sun-fill text-warning"></i>
                                            <span class="small fw-medium">Clean Light</span>
                                        </button>
                                    </li>
                                    <li>
                                        <button class="dropdown-item d-flex align-items-center gap-2 py-2 px-3 cursor-pointer text-light" onclick="setAppTheme('mint-dark')">
                                            <i class="bi bi-droplet-fill text-info"></i>
                                            <span class="small fw-medium">Cyber Teal</span>
                                        </button>
                                    </li>
                                    <li>
                                        <button class="dropdown-item d-flex align-items-center gap-2 py-2 px-3 cursor-pointer text-light" onclick="setAppTheme('emerald')">
                                            <i class="bi bi-gem text-emerald"></i>
                                            <span class="small fw-medium">Emerald Glow</span>
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="app-body">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="custom-footer border-top border-light border-opacity-10 py-4 mt-5">
        <div class="container text-center">
            <div class="d-flex justify-content-center align-items-center gap-2 mb-2">
                <img src="https://iili.io/CUdicRp.png" alt="MovieSync" style="height: 24px; width: auto; object-fit: contain;" />
                <span class="fw-bold text-white">MovieSync</span>
            </div>
            <p class="text-muted small mb-0">&copy; 2026 - Synchronized Real-time Theatre. All Rights Reserved.</p>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Firebase SDK Initialization -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";

        const firebaseConfig = {
            apiKey: "AIzaSyCssJy7q2tdMSnHJ8xfj5Hl5HUqO1TKcrw",
            authDomain: "moviesync-9bcef.firebaseapp.com",
            projectId: "moviesync-9bcef",
            storageBucket: "moviesync-9bcef.firebasestorage.app",
            messagingSenderId: "883297078524",
            appId: "1:883297078524:web:370bcd6b038e5191da5b79"
        };

        const app = initializeApp(firebaseConfig);
        console.log("Firebase initialized successfully on client!");
    </script>

    <!-- Global App Shell Scripts -->
    <script>
        async function logoutUser() {
            try {
                const response = await fetch('/api/auth/logout', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                if (response.ok) {
                    window.location.href = '/Login';
                } else {
                    alert('Logout failed.');
                }
            } catch (err) {
                console.error(err);
                window.location.href = '/Login';
            }
        }

        function setAppTheme(theme) {
            document.documentElement.setAttribute("data-theme", theme);
            localStorage.setItem("theme", theme);
            updateThemeLabel(theme);
        }

        function toggleDarkMode() {
            const currentTheme = document.documentElement.getAttribute("data-theme") || "dark";
            let nextTheme = "dark";
            if (currentTheme === "dark") nextTheme = "light";
            else if (currentTheme === "light") nextTheme = "mint-dark";
            else if (currentTheme === "mint-dark") nextTheme = "emerald";
            else nextTheme = "dark";
            setAppTheme(nextTheme);
        }

        function updateThemeLabel(theme) {
            const icons = document.querySelectorAll("#theme-icon");
            const labels = document.querySelectorAll("#theme-label");
            
            labels.forEach(lbl => {
                if (theme === "light") lbl.innerText = "Clean Light";
                else if (theme === "mint-dark") lbl.innerText = "Cyber Teal";
                else if (theme === "emerald") lbl.innerText = "Emerald Glow";
                else lbl.innerText = "Midnight Dark";
            });

            icons.forEach(icon => {
                if (theme === "light") icon.className = "bi bi-sun-fill text-warning";
                else if (theme === "mint-dark") icon.className = "bi bi-droplet-fill text-info";
                else if (theme === "emerald") icon.className = "bi bi-gem text-success";
                else icon.className = "bi bi-moon-stars-fill text-warning";
            });
        }

        const savedTheme = localStorage.getItem("theme") || "dark";
        document.documentElement.setAttribute("data-theme", savedTheme);
        
        window.addEventListener('DOMContentLoaded', () => {
            updateThemeLabel(savedTheme);
        });
    </script>

    <!-- Load site.js FIRST so window.loginWithEmail is ready globally -->
    <script src="~/js/site.js" type="module" asp-append-version="true"></script>

    <!-- Then render page-specific scripts -->
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>