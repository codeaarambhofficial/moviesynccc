@page
@model MovieSync.Web.Pages.RoomModel
@{
    ViewData["Title"] = "Sync watch Room";
}

<!-- Toast Notifications Container -->
<div id="toast-container" class="toast-container-custom"></div>

<!-- Loading Overlay -->
<div id="loading-overlay" class="position-fixed top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center bg-dark bg-opacity-75 d-none" style="z-index: 10000; backdrop-filter: blur(8px);">
    <div class="spinner-border text-primary fs-3 mb-3" style="width: 3rem; height: 3rem;" role="status"></div>
    <span id="loading-message" class="text-light fw-medium">Joining Room...</span>
</div>

<div class="container-fluid py-4 px-md-4">
    <!-- 1. Lobby / Hero Landing View (Visible when not in a room) -->
    <div id="lobby-section" class="row justify-content-center align-items-center min-vh-75 py-5">
        <div class="col-lg-8 col-xl-7 text-center">
            <div class="hero-wrapper mb-4">
                <div class="d-flex align-items-center justify-content-center gap-3 mb-2">
                    <img src="https://iili.io/CUdicRp.png" alt="MovieSync Logo" style="height: 52px; width: auto; object-fit: contain;" />
                    <h1 class="hero-title mb-0"><span class="bg-gradient-text">MovieSync</span></h1>
                </div>
                <p class="hero-subtitle">Watch YouTube, MP4 videos, and web streams together in perfect real-time synchronization. Chat, react, and share the experience with your friends.</p>
                
                <div class="lobby-features-grid mt-4">
                    <div class="glass-panel lobby-feature-card">
                        <div class="lobby-feature-icon">⚡</div>
                        <h5 class="fw-bold mb-2">Live Sync</h5>
                        <p class="text-muted small mb-0">Zero latency play, pause, and seek synchronization.</p>
                    </div>
                    <div class="glass-panel lobby-feature-card">
                        <div class="lobby-feature-icon">💬</div>
                        <h5 class="fw-bold mb-2">Real-time Chat</h5>
                        <p class="text-muted small mb-0">Discord-style chat with emoji reactions and system logs.</p>
                    </div>
                    <div class="glass-panel lobby-feature-card">
                        <div class="lobby-feature-icon">🛡️</div>
                        <h5 class="fw-bold mb-2">Host Controls</h5>
                        <p class="text-muted small mb-0">Lock syncing so only you control playback and video loads.</p>
                    </div>
                </div>

                <div class="row justify-content-center gap-3 mt-4">
                    <div class="col-sm-5 glass-panel p-4 text-start">
                        <h5 class="fw-bold mb-3 text-gradient-primary"><i class="bi bi-plus-circle-fill me-2"></i>Start Fresh</h5>
                        <p class="text-muted small mb-4">Create a brand new private watch room with a randomized code instantly.</p>
                        <button id="lobby-create-btn" class="btn btn-primary-gradient w-100 py-2.5">
                            <i class="bi bi-magic me-1"></i> Create Room
                        </button>
                    </div>
                    
                    <div class="col-sm-5 glass-panel p-4 text-start">
                        <h5 class="fw-bold mb-3 text-gradient-primary"><i class="bi bi-door-open-fill me-2"></i>Join Existing</h5>
                        <div class="mb-3">
                            <label for="lobby-room-input" class="form-label small text-muted">Room Code / ID</label>
                            <input type="text" id="lobby-room-input" class="form-control form-control-custom" placeholder="e.g. space-cinema-24" />
                        </div>
                        <button id="lobby-join-btn" class="btn btn-glass w-100 py-2.5">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Join Room
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Active Theatre Dashboard Layout (Visible once user joins a room) -->
    <div id="room-dashboard" class="dashboard-layout d-none">
        
        <!-- Main Theater Column (Video & Stream Loader) -->
        <div class="theater-col">
            <!-- Room Info Header -->
            <div class="glass-panel p-3 mb-2 d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary bg-opacity-10 p-2.5 rounded-3 border border-primary border-opacity-20 d-flex align-items-center justify-content-center text-primary">
                        <i class="bi bi-tv-fill fs-4"></i>
                    </div>
                    <div>
                        <h4 class="mb-0 fw-bold d-flex align-items-center gap-2">
                            Room: <span id="current-room-display" class="bg-gradient-text">...</span>
                        </h4>
                        <span class="text-muted small d-flex align-items-center gap-1 mt-1">
                            <i class="bi bi-person-fill text-primary"></i> Host: <span id="current-host-display" class="fw-semibold">...</span>
                        </span>
                    </div>
                </div>
                
                <div class="d-flex align-items-center gap-2">
                    <button id="invite-btn" class="btn btn-glass btn-sm d-flex align-items-center gap-2 py-2 px-3 rounded-pill" title="Copy Invite URL">
                        <i class="bi bi-share-fill"></i> Copy Invite Link
                    </button>
                    
                    <!-- Host Lock Settings Badge (Controlled via SignalR) -->
                    <div id="lock-control-container" class="d-none">
                        <button id="lock-toggle-btn" class="btn btn-outline-warning btn-sm d-flex align-items-center gap-2 py-2 px-3 rounded-pill">
                            <i class="bi bi-unlock-fill" id="lock-icon"></i> <span id="lock-text">Unlock Settings</span>
                        </button>
                    </div>
                    <span id="locked-badge" class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-20 py-2 px-3 rounded-pill d-none">
                        <i class="bi bi-lock-fill me-1"></i> Sync Locked by Host
                    </span>
                </div>
            </div>

            <!-- Theater Main Grid (Player & Video Call Side-by-Side on Desktop, split top/bottom on Mobile) -->
            <div class="theater-main-view mb-3">
                
                <!-- Player area (Left Column on Desktop) -->
                <div class="player-area-col" id="player-area-col">
                    <!-- Ambient Video Screen Frame -->
                    <div class="player-wrapper mb-3">
                        <div class="ratio ratio-16x9 position-relative">
                            <div id="player-container" class="w-100 h-100 position-absolute top-0 start-0 bg-black overflow-hidden">
                                <div id="youtube-player-wrapper" class="w-100 h-100 position-absolute top-0 start-0" style="display: none;"><div id="youtube-player" class="w-100 h-100"></div></div>
                                <video id="html5-player" controls class="w-100 h-100 position-absolute top-0 start-0" style="display: none;">
                                    Your browser does not support HTML5 video player playback.
                                </video>
                                <iframe id="iframe-player" class="w-100 h-100 position-absolute top-0 start-0 border-0" style="display: none;" allowfullscreen></iframe>
                            </div>

                            <!-- Floating Reactions Overlay Canvas/Container -->
                            <div id="floating-reactions" style="position: absolute; bottom: 60px; right: 30px; pointer-events: none; z-index: 1000; width: 100%; height: 80%;"></div>
                        </div>
                    </div>

                    <!-- Media Streaming & Track Control Bar -->
                    <div class="glass-panel p-2.5 px-3 mb-3 d-flex flex-wrap align-items-center justify-content-between gap-2 border border-white border-opacity-10 rounded-3">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span id="stream-status-badge" class="status-badge-custom status-ready">
                                <i class="bi bi-broadcast text-danger animate-pulse"></i> <span id="stream-status-text">Ready to Sync</span>
                            </span>
                            <span id="now-playing-badge" class="text-light small fw-medium text-truncate" style="max-width: 280px;" title="Current Title">
                                <i class="bi bi-film text-warning me-1"></i> <span id="active-video-title">No Video Loaded</span>
                            </span>
                        </div>
                        
                        <div class="d-flex align-items-center gap-2 flex-wrap ms-auto">
                            <!-- Audio Track Selector -->
                            <div class="dropdown" id="audio-track-dropdown-container">
                                <button class="btn btn-dark btn-sm rounded-pill px-2.5 py-1 text-light border border-secondary border-opacity-20 dropdown-toggle small d-flex align-items-center gap-1" type="button" data-bs-toggle="dropdown" id="audio-track-btn">
                                    <i class="bi bi-volume-up-fill text-info"></i> Audio Track
                                </button>
                                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow" id="audio-track-menu">
                                    <li><a class="dropdown-item active small" href="javascript:void(0)" onclick="selectAudioTrack(-1)">Default Audio</a></li>
                                </ul>
                            </div>

                            <!-- Subtitle Track Selector -->
                            <div class="dropdown" id="sub-track-dropdown-container">
                                <button class="btn btn-dark btn-sm rounded-pill px-2.5 py-1 text-light border border-secondary border-opacity-20 dropdown-toggle small d-flex align-items-center gap-1" type="button" data-bs-toggle="dropdown" id="sub-track-btn">
                                    <i class="bi bi-cc-square-fill text-warning"></i> Subtitles
                                </button>
                                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow" id="sub-track-menu">
                                    <li><a class="dropdown-item active small" href="javascript:void(0)" onclick="selectSubtitleTrack(-1)">Off</a></li>
                                </ul>
                            </div>

                            <!-- Playback Speed Selector -->
                            <div class="dropdown">
                                <button class="btn btn-dark btn-sm rounded-pill px-2.5 py-1 text-light border border-secondary border-opacity-20 dropdown-toggle small d-flex align-items-center gap-1" type="button" data-bs-toggle="dropdown" id="speed-btn">
                                    <i class="bi bi-speedometer2 text-primary"></i> <span id="speed-label">1.0x</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow">
                                    <li><a class="dropdown-item small" href="javascript:void(0)" onclick="changePlaybackSpeed(0.5)">0.5x</a></li>
                                    <li><a class="dropdown-item small" href="javascript:void(0)" onclick="changePlaybackSpeed(0.75)">0.75x</a></li>
                                    <li><a class="dropdown-item active small" href="javascript:void(0)" onclick="changePlaybackSpeed(1.0)">1.0x (Normal)</a></li>
                                    <li><a class="dropdown-item small" href="javascript:void(0)" onclick="changePlaybackSpeed(1.25)">1.25x</a></li>
                                    <li><a class="dropdown-item small" href="javascript:void(0)" onclick="changePlaybackSpeed(1.5)">1.5x</a></li>
                                    <li><a class="dropdown-item small" href="javascript:void(0)" onclick="changePlaybackSpeed(2.0)">2.0x</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Watch Party Call Control Banner -->
                    <div class="glass-panel p-3 mb-3 d-flex align-items-center justify-content-between flex-wrap gap-3" id="call-status-banner">
                        <div class="d-flex align-items-center gap-3">
                            <div class="d-flex align-items-center justify-content-center text-white rounded-3 p-2" style="width: 42px; height: 42px; background-color: #073F78;">
                                <i class="bi bi-camera-video-fill fs-5"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-white d-flex align-items-center gap-2" style="font-size: 0.95rem;">
                                    Live Watch Party Call
                                    <span id="call-active-badge" class="badge bg-secondary rounded-pill px-2 py-1 small fw-normal">0 active</span>
                                </div>
                                <div class="small text-light" id="call-members-avatars" style="color: #cbd5e1 !important;">
                                    No active members in call yet. Click Join Video Call!
                                </div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button id="btn-toggle-join-call" onclick="toggleJoinCall()" class="btn btn-primary-gradient btn-sm px-3 py-2 fw-semibold d-flex align-items-center gap-2">
                                <i class="bi bi-telephone-fill" id="call-join-icon"></i>
                                <span id="call-join-text">Join Video Call</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- WebRTC Live Video Calling Section (Right Column on Desktop, Split Top/Bottom on Mobile) -->
                <div id="webrtc-calling-section" class="webrtc-calling-container d-none">
                    
                    <!-- Upper video grid (top-right on desktop, top of player on mobile) -->
                    <div id="webrtc-video-grid-upper" class="webrtc-video-grid-split">
                        <!-- Upper/Even feeds distributed dynamically -->
                    </div>

                    <!-- Compact Unified Call Controls -->
                    <div id="webrtc-controls-panel" class="glass-panel p-2.5 mb-2 border border-white border-opacity-10 d-flex flex-column gap-2" style="grid-area: controls-panel;">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                            <span class="small fw-bold text-white d-flex align-items-center gap-1.5" style="font-size: 0.85rem;">
                                <span class="status-dot animate-pulse"></span> Live Call
                            </span>
                            <div class="d-flex gap-2">
                                <button id="webrtc-toggle-mic" class="btn btn-outline-success btn-sm rounded-circle d-flex align-items-center justify-content-center border-opacity-30 active" style="width: 34px; height: 34px;" title="Mute/Unmute Mic">
                                    <i class="bi bi-mic-fill" id="webrtc-mic-icon"></i>
                                </button>
                                <button id="webrtc-toggle-cam" class="btn btn-outline-success btn-sm rounded-circle d-flex align-items-center justify-content-center border-opacity-30 active" style="width: 34px; height: 34px;" title="Camera On/Off">
                                    <i class="bi bi-camera-video-fill" id="webrtc-cam-icon"></i>
                                </button>
                                <button onclick="toggleJoinCall()" class="btn btn-danger btn-sm rounded-circle d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;" title="Leave Video Call">
                                    <i class="bi bi-telephone-x-fill"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Lower video grid (bottom-right on desktop, bottom of player on mobile) -->
                    <div id="webrtc-video-grid-lower" class="webrtc-video-grid-split">
                        <!-- Lower/Odd feeds distributed dynamically -->
                    </div>

                    <!-- Hidden helper grid to satisfy legacy JS queries -->
                    <div id="webrtc-video-grid" style="display: none;">
                        <!-- Local stream card inside helper grid -->
                        <div class="webrtc-video-box glass-panel local-video-box" id="local-video-container">
                            <video id="local-video" autoplay muted playsinline class="webrtc-video-element"></video>
                            <div class="webrtc-video-label">You</div>
                            <div class="webrtc-video-avatar" id="local-video-avatar" style="display: none;">U</div>
                            <div class="webrtc-mic-badge bg-danger text-white rounded-circle p-1 d-none" id="local-mic-badge">
                                <i class="bi bi-mic-mute-fill"></i>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Loader Tabs Panel (Load URL / Search YouTube / Share Screen) -->
            <div class="glass-panel p-4">
                <ul class="nav nav-tabs nav-tabs-custom mb-3" id="videoSourceTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="url-tab" data-bs-toggle="tab" data-bs-target="#url-loader-pane" type="button" role="tab"><i class="bi bi-link-45deg me-1"></i> Direct URL / Stream</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="search-tab" data-bs-toggle="tab" data-bs-target="#search-loader-pane" type="button" role="tab"><i class="bi bi-search me-1"></i> Search YouTube</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="screen-share-tab" data-bs-toggle="tab" data-bs-target="#screen-share-loader-pane" type="button" role="tab"><i class="bi bi-display me-1 text-info"></i> Share Screen</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="participants-tab" data-bs-toggle="tab" data-bs-target="#participants-pane" type="button" role="tab"><i class="bi bi-people-fill me-1"></i> Users (<span id="user-count-badge">0</span>)</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="history-tab" data-bs-toggle="tab" data-bs-target="#history-pane" type="button" role="tab"><i class="bi bi-clock-history me-1"></i> Queue</button>
                    </li>
                </ul>

                <div class="tab-content" id="videoSourceTabsContent">
                    <!-- URL Loader Tab -->
                    <div class="tab-pane fade show active" id="url-loader-pane" role="tabpanel">
                        <div class="row g-2">
                            <div class="col">
                                <input type="text" id="video-url-input" class="form-control form-control-custom" placeholder="Paste YouTube link, MP4 URL, or direct video stream..." />
                            </div>
                            <div class="col-auto">
                                <button id="load-video-btn" class="btn btn-primary-gradient px-4 h-100">
                                    <i class="bi bi-cloud-arrow-down-fill me-1"></i> Load Stream
                                </button>
                            </div>
                        </div>
                        <div class="form-text mt-2 small d-flex justify-content-between align-items-center" style="color: #cbd5e1 !important;">
                            <span><i class="bi bi-info-circle me-1 text-info"></i> Supports YouTube links, direct <code>.mp4</code>/<code>.webm</code> video URLs, and HLS streams.</span>
                        </div>
                    </div>

                    <!-- YouTube Search Tab -->
                    <div class="tab-pane fade" id="search-loader-pane" role="tabpanel">
                        <div class="row g-2 mb-3">
                            <div class="col">
                                <input type="text" id="yt-search-input" class="form-control form-control-custom" placeholder="Search for movies, clips, or music..." />
                            </div>
                            <div class="col-auto">
                                <button id="yt-search-btn" class="btn btn-primary-gradient px-4 h-100">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </div>
                        <!-- Search results container -->
                        <div id="search-results-container" class="search-results-grid">
                            <div class="text-center py-4 w-100 text-light" style="color: #cbd5e1 !important;">
                                <i class="bi bi-search fs-2 d-block mb-2 text-info"></i> Enter keywords to search YouTube
                            </div>
                        </div>
                    </div>

                    <!-- Screen Share Tab -->
                    <div class="tab-pane fade" id="screen-share-loader-pane" role="tabpanel">
                        <div class="p-4 text-center rounded-3" style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1);">
                            <div class="mb-3">
                                <i class="bi bi-display fs-1 text-info"></i>
                            </div>
                            <h5 class="fw-bold text-white mb-2">Share Your Screen or Window</h5>
                            <p class="mb-3 small" style="color: #e2e8f0 !important; max-width: 500px; margin: 0 auto;">Stream your browser tab, desktop, or application window live to the video theater frame in real time.</p>
                            <div class="d-flex justify-content-center gap-2">
                                <button id="start-screen-share-btn" onclick="toggleScreenShare()" class="btn btn-info px-4 py-2.5 rounded-pill shadow-sm fw-semibold d-flex align-items-center gap-2">
                                    <i class="bi bi-display-fill" id="screen-share-icon"></i>
                                    <span id="screen-share-btn-text">Start Screen Share</span>
                                </button>
                            </div>
                            <div id="screen-share-status" class="mt-3 badge bg-info bg-opacity-20 text-info border border-info border-opacity-30 px-3 py-2 rounded-pill d-none">
                                <i class="bi bi-circle-fill me-1 text-danger animate-pulse"></i> Screen Sharing Active
                            </div>
                        </div>
                    </div>

                    <!-- Users (Participants) Tab -->
                    <div class="tab-pane fade p-3" id="participants-pane" role="tabpanel">
                        <h6 class="fw-bold mb-3"><i class="bi bi-person-fill text-primary me-1"></i> Active in Room</h6>
                        <ul id="participants-list-ul" class="participants-list">
                            <!-- Populated dynamically via JS -->
                        </ul>
                    </div>

                    <!-- Queue (History & Favorites) Tab -->
                    <div class="tab-pane fade p-3" id="history-pane" role="tabpanel">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h6 class="fw-bold mb-0"><i class="bi bi-star-fill text-warning me-1"></i> Favorites</h6>
                            <button id="favorite-current-btn" class="btn btn-link text-warning text-decoration-none p-0 small">
                                <i class="bi bi-star-fill me-1"></i> Add Active
                            </button>
                        </div>
                        <div id="favorites-list-container" class="mb-4">
                            <p class="text-muted small text-center py-2">No favorites yet. Add the active video!</p>
                        </div>

                        <hr class="border-light border-opacity-10 my-3" />

                        <h6 class="fw-bold mb-3"><i class="bi bi-clock-history text-primary me-1"></i> Watch History</h6>
                        <div id="history-list-container">
                            <p class="text-muted small text-center py-2">No videos played recently.</p>
                        </div>
                    </div>
                </div>
                
                <!-- Quick Reactions Toolbar -->
                <div class="d-flex align-items-center justify-content-between mt-3 pt-3 border-top border-light border-opacity-10 flex-wrap gap-2">
                    <span class="small fw-bold text-white d-flex align-items-center gap-1.5" style="font-size: 0.95rem;">
                        <i class="bi bi-emoji-smile text-warning fs-5"></i> Broadcast Reaction:
                    </span>
                    <div class="d-flex gap-2 flex-wrap">
                        <button class="btn btn-glass btn-sm px-3 py-2 fs-6 rounded-pill text-white border border-light border-opacity-10" onclick="sendReaction('❤️')">❤️ Love</button>
                        <button class="btn btn-glass btn-sm px-3 py-2 fs-6 rounded-pill text-white border border-light border-opacity-10" onclick="sendReaction('😂')">😂 Haha</button>
                        <button class="btn btn-glass btn-sm px-3 py-2 fs-6 rounded-pill text-white border border-light border-opacity-10" onclick="sendReaction('😮')">😮 Wow</button>
                        <button class="btn btn-glass btn-sm px-3 py-2 fs-6 rounded-pill text-white border border-light border-opacity-10" onclick="sendReaction('🔥')">🔥 Fire</button>
                        <button class="btn btn-glass btn-sm px-3 py-2 fs-6 rounded-pill text-white border border-light border-opacity-10" onclick="sendReaction('👍')">👍 Like</button>
                        <button class="btn btn-glass btn-sm px-3 py-2 fs-6 rounded-pill text-white border border-light border-opacity-10" onclick="sendReaction('🍿')">🍿 Popcorn</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Floating Chat FAB Button -->
        <button id="chat-fab" class="btn btn-primary-gradient rounded-circle shadow-lg d-flex align-items-center justify-content-center" onclick="toggleChatPopup()">
            <i class="bi bi-chat-dots-fill"></i>
            <span id="chat-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" style="font-size: 0.75rem;">0</span>
        </button>

        <!-- Floating Popup Chat Window -->
        <div id="chat-popup" class="glass-panel position-fixed shadow-lg d-none d-flex flex-column">
            <div class="chat-popup-header d-flex align-items-center justify-content-between p-3 border-bottom border-light border-opacity-10">
                <div class="d-flex align-items-center gap-2">
                    <span class="status-dot bg-success"></span>
                    <span class="fw-bold text-white small">Room Chat</span>
                </div>
                <button onclick="toggleChatPopup()" class="btn btn-link text-white text-decoration-none p-1 line-height-1" title="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            
            <div class="chat-messages-area flex-grow-1 p-3" id="chat-messages">
                <!-- Empty Chat Illustration -->
                <div id="empty-chat-placeholder" class="empty-chat-box">
                    <div class="empty-chat-icon">💬</div>
                    <h6 class="fw-bold">No messages yet</h6>
                    <p class="text-muted small mb-0">Say hello and start the party! 👋</p>
                </div>
            </div>
            
            <div class="chat-footer p-2.5 border-top border-light border-opacity-10">
                <div class="input-group">
                    <input type="text" id="chat-input" class="form-control form-control-custom" placeholder="Type a message..." />
                    <button id="send-btn" class="btn btn-primary-gradient px-3">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
    <script src="https://www.youtube.com/iframe_api"></script>
    <script>
const connection = new signalR.HubConnectionBuilder()
    .withUrl("/hubs/moviesync")
    .withAutomaticReconnect()
    .build();

let currentRoom = "";
let ytPlayer;
let isIncomingEvent = false;
let isHost = false;
let isLocked = false;
let activeVideoUrl = "";
let activeVideoTitle = "Default MovieSync Video";
let lastKnownTime = 0;
let connectionId = "";
let isPlayerReady = false;
let pendingVideo = null;
let lastReceivedState = null;

// WebRTC Global State
let localStream = null;
let isMicMuted = false;
let isCameraOff = false;
const peerConnections = {}; // peerConnectionId -> RTCPeerConnection
let hlsInstance = null;
let driftSyncInterval = null;

const getYtWrapper = () => document.getElementById("youtube-player-wrapper");
const isYtActive = () => { const w = getYtWrapper(); return w && w.style.display !== "none"; };
const html5Player = document.getElementById("html5-player");
const iframePlayer = document.getElementById("iframe-player");

// Custom Toast Notifications
function showToast(type, text) {
    const container = document.getElementById("toast-container");
    const toast = document.createElement("div");
    toast.className = `toast-custom ${type}`;
    
    let icon = "bi-info-circle-fill";
    if (type === "success") icon = "bi-check-circle-fill";
    if (type === "error") icon = "bi-exclamation-triangle-fill";

    toast.innerHTML = `
        <i class="bi ${icon} toast-icon"></i>
        <div class="toast-body small fw-medium">${text}</div>
    `;
    
    container.appendChild(toast);
    
    setTimeout(() => {
        toast.style.animation = "fadeOut 0.4s ease forwards";
        setTimeout(() => toast.remove(), 400);
    }, 4000);
}

function toggleLoading(show, message = "Processing...") {
    const overlay = document.getElementById("loading-overlay");
    const msgEl = document.getElementById("loading-message");
    msgEl.innerText = message;
    if (show) {
        overlay.classList.remove("d-none");
    } else {
        overlay.classList.add("d-none");
    }
}

// Initial YouTube Iframe Setup
function onYouTubeIframeAPIReady() {
    ytPlayer = new YT.Player('youtube-player', {
        height: '100%',
        width: '100%',
        videoId: 'sElE_BfQ67s',
        playerVars: {
            'playsinline': 1,
            'controls': 1,
            'rel': 0
        },
        events: { 
            'onStateChange': onPlayerStateChange,
            'onReady': onPlayerReady,
            'onError': onPlayerError
        }
    });
}

function onPlayerError(event) {
    console.error("YouTube Player Error Code:", event.data);
    let message = "This video can't be played.";
    if (event.data === 101 || event.data === 150) {
        message = "This video's owner doesn't allow it to be played in embedded players.";
    } else if (event.data === 100) {
        message = "This video was removed or is private.";
    } else if (event.data === 2) {
        message = "Invalid video ID.";
    }
    showToast("error", message);
}

function onPlayerReady(event) {
    isPlayerReady = true;
    console.log("YouTube Player is ready.");
    
    // Hide youtube container by default unless pending video is youtube
    if (!pendingVideo || !extractYtId(pendingVideo.url)) {
        const wrapper = getYtWrapper();
        if (wrapper) wrapper.style.display = "none";
    }

    if (pendingVideo) {
        handleVideoSwitch(pendingVideo.url, pendingVideo.title, false, pendingVideo.startTime || 0);
        pendingVideo = null;
    }

    const urlParams = new URLSearchParams(window.location.search);
    const rId = urlParams.get('roomId');
    if (rId && !currentRoom) {
        toggleLoading(true, `Connecting to Room ${rId}...`);
        joinWatchRoom(rId);
    }
}

function syncPlayerToState(state) {
    if (!isPlayerReady) return;
    
    const stateIsPlaying = state.isPlaying !== undefined ? state.isPlaying : state.IsPlaying;
    
    isIncomingEvent = true;
    
    const playerTime = getPlayerCurrentTime();
    const hostTime = getEstimatedHostTime();
    
    if (playerTime !== null && Math.abs(playerTime - hostTime) > 3) {
        seekPlayerTo(hostTime);
    }
    
    const isPlaying = isPlayerActuallyPlaying();
    if (stateIsPlaying && !isPlaying) {
        startPlayerPlayback();
    } else if (!stateIsPlaying && isPlaying) {
        pausePlayerPlayback();
    }
    
    setTimeout(() => { isIncomingEvent = false; }, 500);
}

// >>> CHANGED: onPlayerStateChange now also updates lastReceivedState locally,
// so the drift checker knows the real current time/playing status.
function onPlayerStateChange(event) {
    if (isIncomingEvent || !currentRoom) return;

    if (isLocked && !isHost) {
        showToast("error", "Only the host can control playback when room is locked.");
        isIncomingEvent = true;
        if (event.data === YT.PlayerState.PLAYING) {
            ytPlayer.pauseVideo();
        } else if (event.data === YT.PlayerState.PAUSED) {
            ytPlayer.playVideo();
        }
        setTimeout(() => isIncomingEvent = false, 200);
        return;
    }

    const currentTime = ytPlayer.getCurrentTime();
    if (event.data == YT.PlayerState.PLAYING) {
        connection.invoke("PlayVideo", currentRoom, currentTime);
        if (lastReceivedState) { // >>> CHANGED
            lastReceivedState.currentTime = currentTime;
            lastReceivedState.isPlaying = true;
            lastReceivedState.lastUpdated = new Date().toISOString();
        }
    } else if (event.data == YT.PlayerState.PAUSED) {
        connection.invoke("PauseVideo", currentRoom, currentTime);
        if (lastReceivedState) { // >>> CHANGED
            lastReceivedState.currentTime = currentTime;
            lastReceivedState.isPlaying = false;
            lastReceivedState.lastUpdated = new Date().toISOString();
        }
    }
}

// >>> CHANGED: html5 play/pause/seeked handlers also update lastReceivedState
html5Player.addEventListener("play", () => {
    if (isIncomingEvent || !currentRoom) return;
    if (isLocked && !isHost) {
        showToast("error", "Sync is locked by the host.");
        isIncomingEvent = true;
        html5Player.pause();
        setTimeout(() => isIncomingEvent = false, 200);
        return;
    }
    connection.invoke("PlayVideo", currentRoom, html5Player.currentTime);
    if (lastReceivedState) { // >>> CHANGED
        lastReceivedState.currentTime = html5Player.currentTime;
        lastReceivedState.isPlaying = true;
        lastReceivedState.lastUpdated = new Date().toISOString();
    }
});

html5Player.addEventListener("pause", () => {
    if (isIncomingEvent || !currentRoom) return;
    if (isLocked && !isHost) return;
    connection.invoke("PauseVideo", currentRoom, html5Player.currentTime);
    if (lastReceivedState) { // >>> CHANGED
        lastReceivedState.currentTime = html5Player.currentTime;
        lastReceivedState.isPlaying = false;
        lastReceivedState.lastUpdated = new Date().toISOString();
    }
});

html5Player.addEventListener("seeked", () => {
    if (isIncomingEvent || !currentRoom) return;
    if (isLocked && !isHost) return;
    connection.invoke("SeekVideo", currentRoom, html5Player.currentTime);
    if (lastReceivedState) { // >>> CHANGED
        lastReceivedState.currentTime = html5Player.currentTime;
        lastReceivedState.lastUpdated = new Date().toISOString();
    }
});

connection.start().then(() => {
    connectionId = connection.connectionId;
    console.log("SignalR Connected with Connection ID:", connectionId);
}).catch(err => {
    console.error(err);
    showToast("error", "Failed to connect to real-time service.");
});

connection.onreconnecting(() => {
    showToast("info", "Connection lost, reconnecting...");
});

connection.onreconnected(() => {
    if (currentRoom) {
        connection.invoke("JoinRoom", currentRoom);
        showToast("success", "Reconnected!");
    }
});

async function joinWatchRoom(roomId) {
    try {
        if (currentRoom) {
            cleanupWebRtc();
            if (driftSyncInterval) {
                clearInterval(driftSyncInterval);
                driftSyncInterval = null;
            }
            await connection.invoke("LeaveRoom", currentRoom);
        }
        currentRoom = roomId;
        await connection.invoke("JoinRoom", roomId);
        
        const newUrl = `${window.location.protocol}//${window.location.host}${window.location.pathname}?roomId=${encodeURIComponent(roomId)}`;
        window.history.pushState({ path: newUrl }, '', newUrl);

        document.getElementById("lobby-section").classList.add("d-none");
        document.getElementById("room-dashboard").classList.remove("d-none");
        document.getElementById("current-room-display").innerText = roomId;
        
        // Show WebRTC calling grid and activate capture
        document.getElementById("webrtc-calling-section").classList.remove("d-none");
        await startLocalStream();

        // Setup active drift correction checks
        driftSyncInterval = setInterval(checkDriftAndStateSync, 2000);

        toggleLoading(false);
    } catch (err) {
        console.error(err);
        toggleLoading(false);
        showToast("error", "Error joining room. Please try again.");
    }
}

