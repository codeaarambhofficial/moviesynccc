// Chat & UI helpers
function appendChatMessage(username, message, timestamp) {
    const area = document.getElementById("chat-messages");
    const placeholder = document.getElementById("empty-chat-placeholder");
    if (placeholder) placeholder.remove();

    const timeStr = timestamp ? new Date(timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    
    const msgDiv = document.createElement("div");
    msgDiv.className = "chat-message-item mb-2.5";
    msgDiv.innerHTML = `
        <div class="d-flex align-items-baseline justify-content-between mb-1">
            <span class="fw-bold small text-gradient-primary">${username}</span>
            <span class="text-muted" style="font-size: 0.7rem;">${timeStr}</span>
        </div>
        <div class="p-2.5 rounded-3 glass-panel small text-light">${escapeHtml(message)}</div>
    `;
    area.appendChild(msgDiv);
    area.scrollTop = area.scrollHeight;
}

function escapeHtml(text) {
    const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
    return text.replace(/[&<>"']/g, function(m) { return map[m]; });
}

