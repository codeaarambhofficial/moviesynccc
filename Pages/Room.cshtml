    activeVideoTitle = title;
    handleVideoSwitch(url, title, true, time);
    showToast("info", `Now Playing: ${title}`);
    // >>> CHANGED: keep lastReceivedState in sync with the new video/time
    if (lastReceivedState) {
        lastReceivedState.currentTime = time || 0;
        lastReceivedState.isPlaying = false;
        lastReceivedState.lastUpdated = new Date().toISOString();
    }
});

// >>> CHANGED: VideoPlayed now updates lastReceivedState
connection.on("VideoPlayed", (time) => {
    isIncomingEvent = true;
    seekPlayerTo(time);
    startPlayerPlayback();
    if (lastReceivedState) {
        lastReceivedState.currentTime = time;
        lastReceivedState.isPlaying = true;
        lastReceivedState.lastUpdated = new Date().toISOString();
    }
    setTimeout(() => isIncomingEvent = false, 500);
});

// >>> CHANGED: VideoPaused now updates lastReceivedState
connection.on("VideoPaused", (time) => {
    isIncomingEvent = true;
    seekPlayerTo(time);
    pausePlayerPlayback();
    if (lastReceivedState) {
        lastReceivedState.currentTime = time;
        lastReceivedState.isPlaying = false;
        lastReceivedState.lastUpdated = new Date().toISOString();
    }
    setTimeout(() => isIncomingEvent = false, 500);
});

// >>> CHANGED: VideoSought now updates lastReceivedState
connection.on("PositionSynced", (hostTime, rate) => {
    if (isIncomingEvent || isHost || !currentRoom) return;
    const localTime = getPlayerCurrentTime();
    if (localTime !== null && localTime !== undefined) {
        const difference = hostTime - localTime;
        const absDiff = Math.abs(difference);

        if (absDiff < 0.2) {
            if (html5Player && html5Player.style.display !== "none") html5Player.playbackRate = 1.0;
        } else if (absDiff >= 0.2 && absDiff < 1.0) {
            if (html5Player && html5Player.style.display !== "none") {
                html5Player.playbackRate = difference > 0 ? 1.02 : 0.98;
            }
        } else if (absDiff >= 1.0) {
            seekPlayerTo(hostTime);
            if (html5Player && html5Player.style.display !== "none") html5Player.playbackRate = 1.0;
        }
    }
});

