// Chat & UI helpers
let isChatOpen = false;
let unreadMessageCount = 0;

function toggleChatPopup() {
    const popup = document.getElementById("chat-popup");
    if (!popup) return;
    
    if (popup.classList.contains("d-none")) {
        popup.classList.remove("d-none");
        isChatOpen = true;
        unreadMessageCount = 0;
        const badge = document.getElementById("chat-badge");
        if (badge) {
            badge.classList.add("d-none");
            badge.innerText = "0";
        }
        
        const area = document.getElementById("chat-messages");
        if (area) area.scrollTop = area.scrollHeight;
        
        const chatInput = document.getElementById("chat-input");
        if (chatInput) chatInput.focus();
    } else {
        popup.classList.add("d-none");
        isChatOpen = false;
    }
}

function appendChatMessage(username, message, timestamp) {
    const area = document.getElementById("chat-messages");
    const placeholder = document.getElementById("empty-chat-placeholder");
    if (placeholder) placeholder.remove();

    if (!isChatOpen) {
        unreadMessageCount++;
        const badge = document.getElementById("chat-badge");
        if (badge) {
            badge.innerText = unreadMessageCount;
            badge.classList.remove("d-none");
        }
    }

    // Check if current user is the author
    let currentUsername = "";
    try {
        const userBadge = document.querySelector(".user-badge span");
        if (userBadge) currentUsername = userBadge.innerText.trim();
    } catch(e) {}

    const isSelf = username && currentUsername && (username.toLowerCase() === currentUsername.toLowerCase() || username.toLowerCase().split('@@')[0] === currentUsername.toLowerCase());

    const timeStr = timestamp ? new Date(timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    
    const rowDiv = document.createElement("div");
    rowDiv.className = `chat-msg-row ${isSelf ? 'self' : 'other'}`;
    
    rowDiv.innerHTML = `
        <div class="chat-bubble">
            ${!isSelf ? `<span class="chat-sender-name">${escapeHtml(username)}</span>` : ''}
            <span class="chat-msg-text">${escapeHtml(message)}</span>
            <span class="chat-msg-meta">
                ${timeStr}
                ${isSelf ? `<i class="bi bi-check2-all ticks"></i>` : ''}
            </span>
        </div>
    `;
    area.appendChild(rowDiv);
    area.scrollTop = area.scrollHeight;
}

function escapeHtml(text) {
    const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
    return text.replace(/[&<>"']/g, function(m) { return map[m]; });
}

