// Helper Player Management Functions
function extractYtId(url) {
    const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
    const match = url.match(regExp);
    return (match && match[2].length === 11) ? match[2] : null;
}

let activeBlobUrl = null;

function resetAllPlayers() {
    // 1. Pause HTML5 Video Player
    if (html5Player) {
        try {
            html5Player.pause();
            html5Player.srcObject = null;
            html5Player.removeAttribute("src");
        } catch (e) {
            console.warn("HTML5 player reset error:", e);
        }
    }

    // 2. Stop YouTube player if playing
    if (isPlayerReady && ytPlayer && typeof ytPlayer.stopVideo === 'function') {
        try {
            ytPlayer.stopVideo();
        } catch (e) {
            console.warn("YouTube player stop error:", e);
        }
    }

    // 3. Destroy active HLS instance if any
    if (hlsInstance) {
        try {
            hlsInstance.destroy();
        } catch (e) {
            console.warn("HLS destroy error:", e);
        }
        hlsInstance = null;
    }

    // 4. Reset Iframe player
    if (iframePlayer) {
        iframePlayer.src = "about:blank";
    }

    // 5. Hide player containers
    const wrapper = getYtWrapper();
    if (wrapper) wrapper.style.display = "none";
    if (html5Player) html5Player.style.display = "none";
    if (iframePlayer) iframePlayer.style.display = "none";
    const promptOverlay = document.getElementById("local-file-prompt-overlay");
    if (promptOverlay) promptOverlay.classList.add("d-none");
}

