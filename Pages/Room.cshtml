});

function loadVideoStream(url, title = "") {
    toggleLoading(true, "Loading Video Stream...");
    
    let finalTitle = title || url;
    let displayUrl = url;

    const ytId = extractYtId(url);
    if (ytId) {
        displayUrl = `https://www.youtube.com/watch?v=${ytId}`;
        if (!title) finalTitle = "YouTube Video";
    } else if (url.match(/\.(mp4|webm|ogg)(\?.*)?$/i)) {
        if (!title) finalTitle = url.substring(url.lastIndexOf('/') + 1).split('?')[0];
    } else {
        if (!title) finalTitle = "External Frame Stream";
    }

    activeVideoUrl = displayUrl;
    activeVideoTitle = finalTitle;

    connection.invoke("ChangeVideo", currentRoom, displayUrl, finalTitle, 0.0);
}

// SignalR Server Handlers
connection.on("ReceiveRoomState", (state) => {
    const hostConnId = state.hostConnectionId || state.HostConnectionId;
    isHost = (hostConnId === connection.connectionId);
    isLocked = state.isLocked || state.IsLocked || false;
    activeVideoUrl = state.currentVideoUrl || state.CurrentVideoUrl || state.videoUrl || state.VideoUrl;
    activeVideoTitle = state.currentVideoTitle || state.CurrentVideoTitle || state.videoTitle || state.VideoTitle || "MovieSync Stream";
    
    document.getElementById("current-host-display").innerText = state.hostUsername || state.HostUsername || "Host";

    // Update Lock UI badges
    const lockContainer = document.getElementById("lock-control-container");
    const lockedBadge = document.getElementById("locked-badge");
    const lockIcon = document.getElementById("lock-icon");
    const lockText = document.getElementById("lock-text");

    if (isHost) {
        lockContainer.classList.remove("d-none");
        lockedBadge.classList.add("d-none");
    } else {
        lockContainer.classList.add("d-none");
        if (isLocked) {
            lockedBadge.classList.remove("d-none");
        } else {
            lockedBadge.classList.add("d-none");
        }
    }

    if (isLocked) {
        lockIcon.className = "bi bi-lock-fill text-warning";
        lockText.innerText = "Locked";
    } else {
        lockIcon.className = "bi bi-unlock-fill text-success";
        lockText.innerText = "Unlocked";
    }

    lastReceivedState = state;
    const initialTime = state.currentTime || state.CurrentTime || 0;
    if (activeVideoUrl) {
        handleVideoSwitch(activeVideoUrl, activeVideoTitle, false, initialTime);
    } else {
        handleVideoSwitch("local://Movie", activeVideoTitle || "Local Movie", false, initialTime);
    }

    updateParticipantsList(state.participants || state.Participants);
    syncWebRtcPeers(state.participants || state.Participants);
    updateHistoryAndFavoritesLists(state.watchHistory || state.WatchHistory || state.history, state.favorites || state.Favorites);
    toggleLoading(false);
});

connection.on("VideoChanged", (url, title, time) => {
