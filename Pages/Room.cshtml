// Helper Player Management Functions
function extractYtId(url) {
    const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
    const match = url.match(regExp);
    return (match && match[2].length === 11) ? match[2] : null;
}

function handleVideoSwitch(url, title, notifyServer = false, startTime = 0) {
    const ytId = extractYtId(url);
    
    if (hlsInstance) {
        hlsInstance.destroy();
        hlsInstance = null;
    }

    if (ytId) {
        ytContainer.style.display = "block";
        html5Player.style.display = "none";
        iframePlayer.style.display = "none";

        if (isPlayerReady && ytPlayer && typeof ytPlayer.loadVideoById === 'function') {
            ytPlayer.loadVideoById({ 'videoId': ytId, 'startSeconds': startTime });
        } else {
            pendingVideo = { url: url, title: title };
        }
    } else if (url.match(/\.m3u8($|\?)/i)) {
        ytContainer.style.display = "none";
        html5Player.style.display = "block";
        iframePlayer.style.display = "none";

        if (Hls.isSupported()) {
            hlsInstance = new Hls();
            hlsInstance.loadSource(url);
            hlsInstance.attachMedia(html5Player);
            hlsInstance.on(Hls.Events.MANIFEST_PARSED, () => {
                html5Player.currentTime = startTime;
            });
        } else if (html5Player.canPlayType('application/vnd.apple.mpegurl')) {
            html5Player.src = url;
            html5Player.currentTime = startTime;
        }
    } else if (url.startsWith("blob:") || url.match(/\.(mp4|mkv|webm|avi|mov|ogg)(\?.*)?$/i)) {
        ytContainer.style.display = "none";
        html5Player.style.display = "block";
        iframePlayer.style.display = "none";

        if (html5Player.src !== url) {
            html5Player.src = url;
        }
        html5Player.currentTime = startTime;
    } else {
        ytContainer.style.display = "none";
        html5Player.style.display = "none";
        iframePlayer.style.display = "block";
        iframePlayer.src = url;
    }

    toggleLoading(false);
}

function getPlayerCurrentTime() {
    if (ytContainer.style.display !== "none" && isPlayerReady && ytPlayer && typeof ytPlayer.getCurrentTime === 'function') {
        return ytPlayer.getCurrentTime();
    } else if (html5Player.style.display !== "none") {
        return html5Player.currentTime;
    }
    return 0;
}

function seekPlayerTo(time) {
    if (ytContainer.style.display !== "none" && isPlayerReady && ytPlayer && typeof ytPlayer.seekTo === 'function') {
        ytPlayer.seekTo(time, true);
    } else if (html5Player.style.display !== "none") {
        html5Player.currentTime = time;
    }
}

function startPlayerPlayback() {
    if (ytContainer.style.display !== "none" && isPlayerReady && ytPlayer && typeof ytPlayer.playVideo === 'function') {
        ytPlayer.playVideo();
    } else if (html5Player.style.display !== "none") {
        html5Player.play();
    }
}

function pausePlayerPlayback() {
    if (ytContainer.style.display !== "none" && isPlayerReady && ytPlayer && typeof ytPlayer.pauseVideo === 'function') {
        ytPlayer.pauseVideo();
    } else if (html5Player.style.display !== "none") {
        html5Player.pause();
    }
}

function isPlayerActuallyPlaying() {
    if (ytContainer.style.display !== "none" && isPlayerReady && ytPlayer && typeof ytPlayer.getPlayerState === 'function') {
        return ytPlayer.getPlayerState() === YT.PlayerState.PLAYING;
    } else if (html5Player.style.display !== "none") {
        return !html5Player.paused;
    }
    return false;
}

function getEstimatedHostTime() {
    if (lastReceivedState) {
        const baseTime = lastReceivedState.currentTime || lastReceivedState.CurrentTime || 0;
        const updatedAt = lastReceivedState.lastUpdated || lastReceivedState.LastUpdated || Date.now();
        const isPlaying = lastReceivedState.isPlaying !== undefined ? lastReceivedState.isPlaying : lastReceivedState.IsPlaying;
        if (isPlaying) {
            const elapsed = (Date.now() - new Date(updatedAt).getTime()) / 1000;
            return baseTime + Math.max(0, elapsed);
        }
        return baseTime;
    }
    return getPlayerCurrentTime();
}

function checkDriftAndStateSync() {
    if (!lastReceivedState || !currentRoom) return;
    const playerTime = getPlayerCurrentTime();
    const hostTime = getEstimatedHostTime();
    if (playerTime !== null && Math.abs(playerTime - hostTime) > 4.5) {
        console.log(`Drift detected: Player is at ${playerTime.toFixed(1)}s, Host is at ${hostTime.toFixed(1)}s. Resyncing...`);
        seekPlayerTo(hostTime);
    }
}

