function createSyntheticFallbackStream() {
    try {
        const canvas = document.createElement("canvas");
        canvas.width = 320;
        canvas.height = 240;
        const ctx = canvas.getContext("2d");
        ctx.fillStyle = "#1e293b";
        ctx.fillRect(0, 0, 320, 240);
        ctx.fillStyle = "#818cf8";
        ctx.font = "bold 18px sans-serif";
        ctx.fillText("Watch Party Mic/Cam", 50, 125);

        const videoTrack = canvas.captureStream(10).getVideoTracks()[0];

        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = audioCtx.createOscillator();
        const dst = audioCtx.createMediaStreamDestination();
        osc.connect(dst);
        osc.start();
        const audioTrack = dst.stream.getAudioTracks()[0];
        audioTrack.enabled = false;

        return new MediaStream([videoTrack, audioTrack]);
    } catch (e) {
        console.warn("[WebRTC Media] Could not create synthetic stream fallback:", e);
        return null;
    }
}

async function startLocalStream() {
    try {
        localStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
        const localVideoEl = document.getElementById("local-video");
        if (localVideoEl) localVideoEl.srcObject = localStream;
        console.log("[WebRTC Media] Local camera & mic stream acquired.");
    } catch (err) {
        console.warn("[WebRTC Media] Camera/mic access declined or unavailable:", err);
        try {
            localStream = await navigator.mediaDevices.getUserMedia({ video: false, audio: true });
            isCameraOff = true;
            document.getElementById("local-video").style.display = "none";
            document.getElementById("local-video-avatar").style.display = "flex";
            console.log("[WebRTC Media] Local audio-only stream acquired.");
        } catch (e) {
            console.warn("[WebRTC Media] Using synthetic canvas fallback stream for WebRTC call connection");
            localStream = createSyntheticFallbackStream();
            isCameraOff = true;
            document.getElementById("local-video").style.display = "none";
            document.getElementById("local-video-avatar").style.display = "flex";
        }
    }
}

function classifyCandidateType(candidateStr) {
    if (!candidateStr) return "UNKNOWN";
    if (candidateStr.includes("typ host")) return "HOST (LAN)";
    if (candidateStr.includes("typ srflx")) return "STUN (Public)";
    if (candidateStr.includes("typ relay")) return "TURN (Relay)";
    return "PEER";
}

function getOrCreatePeerConnection(targetConnectionId, targetUsername) {
    if (peerConnections[targetConnectionId]) {
        return peerConnections[targetConnectionId].pc;
    }

    console.log(`[WebRTC Init] Creating RTCPeerConnection for target: ${targetConnectionId} (${targetUsername})`);
    const pc = new RTCPeerConnection(rtcConfig);
    const peerObj = {
        pc: pc,
        pendingCandidates: [],
        targetUsername: targetUsername || "Participant",
        iceRestartTimer: null,
        isMakingOffer: false,
        webcamStream: null,
        screenShareStream: null
    };
    peerConnections[targetConnectionId] = peerObj;

    // Attach local stream tracks (webcam & mic)
    if (localStream) {
        localStream.getTracks().forEach(track => {
            try { pc.addTrack(track, localStream); } catch (e) {
                console.warn("[WebRTC Track] Error adding track:", e);
            }
        });
    }

    // Attach screenshare stream tracks if screensharing is active
    if (isScreenSharing && screenShareStream) {
        const senders = [];
        screenShareStream.getTracks().forEach(track => {
            try {
                const sender = pc.addTrack(track, screenShareStream);
                senders.push(sender);
            } catch (e) {
                console.warn("[WebRTC Track] Error adding screen track to new peer:", e);
            }
        });
        screenShareSenders[targetConnectionId] = senders;
    }

    // 0. Negotiation Needed (Renegotiate tracks on screen share start/stop)
    pc.onnegotiationneeded = async () => {
        try {
            console.log(`[WebRTC Negotiation Needed] for target ${targetConnectionId} (state: ${pc.signalingState})`);
            await initiateCallWithPeer(targetConnectionId, targetUsername);
        } catch (err) {
            console.error("[WebRTC Negotiation Error]:", err);
        }
    };

    // 1. ICE Candidate Generation
    pc.onicecandidate = (event) => {
        if (event.candidate) {
            const candType = classifyCandidateType(event.candidate.candidate);
            console.log(`[WebRTC Candidate Generated] To ${targetConnectionId}: Type=${candType}, Proto=${event.candidate.protocol || 'udp'}, Addr=${event.candidate.address || 'hidden'}`);
            if (currentRoom) {
                connection.invoke("SendWebRtcSignal", currentRoom, targetConnectionId, "ice-candidate", JSON.stringify(event.candidate))
                    .catch(err => console.error("[WebRTC Signal Error] Send Candidate failed:", err));
            }
        } else {
            console.log(`[WebRTC Candidate] ICE candidate gathering complete for target ${targetConnectionId}`);
        }
    };

    pc.onicecandidateerror = (event) => {
        console.warn(`[WebRTC ICE Candidate Error] Code ${event.errorCode}: ${event.errorText} (${event.url})`);
    };

    // 2. Track Received
    pc.ontrack = (event) => {
        console.log(`[WebRTC Track Received] Kind=${event.track.kind} from ${targetConnectionId} (${targetUsername})`);
        if (event.streams && event.streams[0]) {
            const incomingStream = event.streams[0];
            const peerObj = peerConnections[targetConnectionId];
            if (peerObj) {
                if (!peerObj.webcamStream) {
                    peerObj.webcamStream = incomingStream;
                    console.log(`[WebRTC Stream] Registered webcam stream for ${targetConnectionId}`);
                    addOrUpdateRemoteVideo(targetConnectionId, targetUsername, incomingStream);
                } else if (peerObj.webcamStream.id !== incomingStream.id) {
                    peerObj.screenShareStream = incomingStream;
                    console.log(`[WebRTC Stream] Registered screenshare stream for ${targetConnectionId}`);
                    if (activeVideoUrl === "screenshare://" + targetConnectionId) {
                        displayRemoteScreenShare(incomingStream);
                    }
                } else {
                    addOrUpdateRemoteVideo(targetConnectionId, targetUsername, incomingStream);
                }
            } else {
                addOrUpdateRemoteVideo(targetConnectionId, targetUsername, incomingStream);
            }
        }
    };

    // 3. ICE Gathering State Logging
    pc.onicegatheringstatechange = () => {
        console.log(`[WebRTC ICE Gathering State] ${targetConnectionId}: ${pc.iceGatheringState}`);
    };

    // 4. ICE Connection State Handling & Auto ICE Restart
    pc.oniceconnectionstatechange = () => {
        const state = pc.iceConnectionState;
        console.log(`[WebRTC ICE Connection State] ${targetConnectionId}: ${state}`);

        if (state === "connected" || state === "completed") {
            console.log(`[WebRTC ICE] Successfully connected P2P/TURN session with ${targetConnectionId}`);
            if (peerObj.iceRestartTimer) {
                clearTimeout(peerObj.iceRestartTimer);
                peerObj.iceRestartTimer = null;
            }
        } else if (state === "disconnected" || state === "failed") {
            console.warn(`[WebRTC ICE Warning] Connection state is '${state}' with ${targetConnectionId}. Scheduling recovery...`);
            if (!peerObj.iceRestartTimer) {
                peerObj.iceRestartTimer = setTimeout(() => {
                    if (pc.iceConnectionState === "failed" || pc.iceConnectionState === "disconnected") {
                        console.log(`[WebRTC ICE Restart] Attempting automatic ICE restart with ${targetConnectionId}...`);
                        triggerIceRestart(targetConnectionId);
                    }
                }, 3000);
            }
        } else if (state === "closed") {
            removeRemoteVideo(targetConnectionId);
        }
    };

    // 5. Peer Connection State Logging
    pc.onconnectionstatechange = () => {
        const state = pc.connectionState;
        console.log(`[WebRTC Connection State] ${targetConnectionId}: ${state}`);
        if (state === "connected") {
            showToast("success", `Connected video call with ${targetUsername} 🟢`);
        } else if (state === "failed") {
            showToast("error", `WebRTC connection failed with ${targetUsername}. Attempting TURN relay restart...`);
        }
    };

    // 6. Signaling State Logging
    pc.onsignalingstatechange = () => {
        console.log(`[WebRTC Signaling State] ${targetConnectionId}: ${pc.signalingState}`);
    };

    return pc;
}

async function processPendingIceCandidates(targetConnectionId) {
    const peerObj = peerConnections[targetConnectionId];
    if (!peerObj || !peerObj.pc) return;

    // First process early candidates buffer if any
    if (earlyCandidatesQueue[targetConnectionId] && earlyCandidatesQueue[targetConnectionId].length > 0) {
        console.log(`[WebRTC Candidates] Flushing ${earlyCandidatesQueue[targetConnectionId].length} early candidates for ${targetConnectionId}`);
        const early = [...earlyCandidatesQueue[targetConnectionId]];
        earlyCandidatesQueue[targetConnectionId] = [];
        for (const candPayload of early) {
            await addIceCandidateSafe(peerObj.pc, candPayload);
        }
    }

    // Process pending candidates on the peer object
    if (peerObj.pendingCandidates && peerObj.pendingCandidates.length > 0) {
        console.log(`[WebRTC Candidates] Flushing ${peerObj.pendingCandidates.length} queued candidates for ${targetConnectionId}`);
        const candidates = [...peerObj.pendingCandidates];
        peerObj.pendingCandidates = [];
        for (const candPayload of candidates) {
            await addIceCandidateSafe(peerObj.pc, candPayload);
        }
    }
}

async function addIceCandidateSafe(pc, candidateData) {
    if (!candidateData) return;
    try {
        if (!candidateData.candidate && candidateData.candidate !== "") {
            return;
        }
        const candType = classifyCandidateType(candidateData.candidate);
        console.log(`[WebRTC Add Candidate] Adding candidate type=${candType}`);
        await pc.addIceCandidate(new RTCIceCandidate(candidateData));
    } catch (err) {
        console.warn("[WebRTC Candidate Add Warning]:", err.message);
    }
}

async function initiateCallWithPeer(targetConnectionId, targetUsername) {
    try {
        console.log(`[WebRTC Offer] Initiating offer to peer: ${targetConnectionId}`);
        const pc = getOrCreatePeerConnection(targetConnectionId, targetUsername);
        const peerObj = peerConnections[targetConnectionId];
        if (peerObj) peerObj.isMakingOffer = true;

        const offerOptions = { offerToReceiveAudio: true, offerToReceiveVideo: true };
        const offer = await pc.createOffer(offerOptions);
        
        if (pc.signalingState !== "stable" && pc.signalingState !== "have-local-offer") {
            console.warn(`[WebRTC Offer Warning] Skipping offer set in state: ${pc.signalingState}`);
            return;
        }

        await pc.setLocalDescription(offer);
        if (peerObj) peerObj.isMakingOffer = false;

        if (currentRoom) {
            await connection.invoke("SendWebRtcSignal", currentRoom, targetConnectionId, "offer", JSON.stringify(offer));
            console.log(`[WebRTC Offer Sent] Successfully sent SDP offer to ${targetConnectionId}`);
        }
    } catch (err) {
        console.error("[WebRTC Offer Error] Error initiating call with peer:", err);
        if (peerConnections[targetConnectionId]) peerConnections[targetConnectionId].isMakingOffer = false;
    }
}

async function triggerIceRestart(targetConnectionId) {
    const peerObj = peerConnections[targetConnectionId];
    if (!peerObj || !peerObj.pc) return;
    const pc = peerObj.pc;
    console.log(`[WebRTC ICE Restart] Re-negotiating ICE with ${targetConnectionId}`);
    try {
        peerObj.isMakingOffer = true;
        const offer = await pc.createOffer({ iceRestart: true, offerToReceiveAudio: true, offerToReceiveVideo: true });
        await pc.setLocalDescription(offer);
        peerObj.isMakingOffer = false;

        if (currentRoom) {
            await connection.invoke("SendWebRtcSignal", currentRoom, targetConnectionId, "offer", JSON.stringify(offer));
        }
    } catch (err) {
        console.error("[WebRTC ICE Restart Error]:", err);
        if (peerObj) peerObj.isMakingOffer = false;
    }
}

async function handleWebRtcOffer(senderConnectionId, offerData) {
    try {
        console.log(`[WebRTC Offer Received] From ${senderConnectionId}`);
        const isPolite = connection.connectionId > senderConnectionId;
        let pc = getOrCreatePeerConnection(senderConnectionId, "Participant");
        const peerObj = peerConnections[senderConnectionId];

        const offerCollision = (pc.signalingState !== "stable" || peerObj.isMakingOffer);

        if (offerCollision) {
            console.warn(`[WebRTC Collision] Collision detected with ${senderConnectionId}. Polite=${isPolite}, State=${pc.signalingState}`);
            if (!isPolite) {
                console.log(`[WebRTC Collision] Impolite peer ignoring offer from ${senderConnectionId}`);
                return;
            }
            try {
                await pc.setLocalDescription({ type: "rollback" });
            } catch (rollbackErr) {
                console.warn("[WebRTC Rollback Warning]:", rollbackErr);
            }
        }

        await pc.setRemoteDescription(new RTCSessionDescription(offerData));
        const answer = await pc.createAnswer();
        await pc.setLocalDescription(answer);

        if (currentRoom) {
            await connection.invoke("SendWebRtcSignal", currentRoom, senderConnectionId, "answer", JSON.stringify(answer));
            console.log(`[WebRTC Answer Sent] Successfully sent SDP answer to ${senderConnectionId}`);
        }

        await processPendingIceCandidates(senderConnectionId);
    } catch (err) {
        console.error("[WebRTC Offer Error] Failed to handle offer:", err);
    }
}

async function handleWebRtcAnswer(senderConnectionId, answerData) {
    try {
        console.log(`[WebRTC Answer Received] From ${senderConnectionId}`);
        const peerObj = peerConnections[senderConnectionId];
        if (peerObj && peerObj.pc) {
            const pc = peerObj.pc;
            if (pc.signalingState === "have-local-offer") {
                await pc.setRemoteDescription(new RTCSessionDescription(answerData));
                console.log(`[WebRTC Answer Set] Remote description set for ${senderConnectionId}`);
                await processPendingIceCandidates(senderConnectionId);
            } else {
                console.warn(`[WebRTC Answer Ignored] Received answer in state '${pc.signalingState}' from ${senderConnectionId}`);
            }
        }
    } catch (err) {
        console.error("[WebRTC Answer Error] Failed to handle answer:", err);
    }
}

async function handleWebRtcCandidate(senderConnectionId, candidateData) {
    try {
        const peerObj = peerConnections[senderConnectionId];
        if (peerObj && peerObj.pc) {
            const pc = peerObj.pc;
            if (pc.remoteDescription && pc.remoteDescription.type) {
                await addIceCandidateSafe(pc, candidateData);
            } else {
                console.log(`[WebRTC Candidate Queued] Remote description not set yet for ${senderConnectionId}. Queueing...`);
                peerObj.pendingCandidates.push(candidateData);
            }
        } else {
            console.log(`[WebRTC Early Candidate Queued] Peer connection not initialized yet for ${senderConnectionId}. Buffering...`);
            if (!earlyCandidatesQueue[senderConnectionId]) {
                earlyCandidatesQueue[senderConnectionId] = [];
            }
            earlyCandidatesQueue[senderConnectionId].push(candidateData);
        }
    } catch (err) {
        console.error("[WebRTC Candidate Error]:", err);
    }
}

function syncWebRtcPeers(participants) {
    if (!participants) return;
    lastParticipantsList = participants;

    // Filter active call members
    const callMembers = participants.filter(p => p.isInCall || p.IsInCall);
    const activeBadge = document.getElementById("call-active-badge");
    if (activeBadge) activeBadge.innerText = `${callMembers.length} active`;

    const avatarsEl = document.getElementById("call-members-avatars");
    if (avatarsEl) {
        if (callMembers.length === 0) {
            avatarsEl.innerText = "No active members in call yet. Click Join Video Call!";
        } else {
            const names = callMembers.map(m => m.username || m.Username).join(", ");
            avatarsEl.innerText = `In call: ${names}`;
        }
    }

    if (!isInCall || !connection || !connection.connectionId) return;

    // Deterministic single-initiator rule: Lower connectionId creates offer
    callMembers.forEach(p => {
        const peerConnId = p.connectionId || p.ConnectionId;
        if (peerConnId && peerConnId !== connection.connectionId) {
            if (!peerConnections[peerConnId]) {
                if (connection.connectionId < peerConnId) {
                    initiateCallWithPeer(peerConnId, p.username || p.Username);
                } else {
                    getOrCreatePeerConnection(peerConnId, p.username || p.Username);
                }
            }
        }
    });

    const activeCallConnIds = callMembers.map(p => p.connectionId || p.ConnectionId);
    Object.keys(peerConnections).forEach(id => {
        if (!activeCallConnIds.includes(id)) {
            removeRemoteVideo(id);
        }
    });
}

function rebalanceVideoGrids() {
    const localBox = document.getElementById("local-video-container");
    const remoteBoxes = Array.from(document.querySelectorAll(".remote-video-box"));
    
    const allBoxes = [];
    if (localBox && isInCall) allBoxes.push(localBox);
    allBoxes.push(...remoteBoxes);
    
    const upperGrid = document.getElementById("webrtc-video-grid-upper");
    const lowerGrid = document.getElementById("webrtc-video-grid-lower");
    const mainView = document.querySelector(".theater-main-view");
    
    if (!upperGrid || !lowerGrid) return;
    
    const activeLabel = document.getElementById("webrtc-call-count-label");
    if (activeLabel) {
        activeLabel.innerText = `${allBoxes.length} participant${allBoxes.length === 1 ? '' : 's'}`;
    }
    
    if (allBoxes.length === 0) {
        if (mainView) mainView.classList.remove("in-call");
        return;
    }
    
    if (mainView) mainView.classList.add("in-call");
    
    allBoxes.forEach((box, index) => {
        if (index % 2 === 0) {
            upperGrid.appendChild(box);
        } else {
            lowerGrid.appendChild(box);
        }
    });
}

function addOrUpdateRemoteVideo(peerId, username, stream) {
    let box = document.getElementById(`peer-box-${peerId}`);
    if (!box) {
        box = document.createElement("div");
        box.className = "webrtc-video-box glass-panel remote-video-box";
        box.id = `peer-box-${peerId}`;
        const initial = (username || 'P').charAt(0).toUpperCase();

        box.innerHTML = `
            <video id="remote-video-${peerId}" autoplay playsinline class="webrtc-video-element"></video>
            <div class="webrtc-video-label">${username || 'Participant'}</div>
            <div class="webrtc-video-avatar" id="remote-avatar-${peerId}" style="display: none;">${initial}</div>
            <div class="webrtc-mic-badge bg-danger text-white rounded-circle p-1 d-none" id="remote-mic-badge-${peerId}">
                <i class="bi bi-mic-mute-fill"></i>
            </div>
        `;

        const grid = document.getElementById("webrtc-video-grid");
        if (grid) grid.appendChild(box);
    }

    const videoEl = document.getElementById(`remote-video-${peerId}`);
    if (videoEl && videoEl.srcObject !== stream) {
        videoEl.srcObject = stream;
        videoEl.play().catch(e => console.log("Remote video play caught:", e));
    }
    rebalanceVideoGrids();
}

function removeRemoteVideo(peerId) {
    const box = document.getElementById(`peer-box-${peerId}`);
    if (box) box.remove();
    if (peerConnections[peerId]) {
        if (peerConnections[peerId].iceRestartTimer) {
            clearTimeout(peerConnections[peerId].iceRestartTimer);
        }
        try { peerConnections[peerId].pc.close(); } catch (e) {}
        delete peerConnections[peerId];
    }
    delete earlyCandidatesQueue[peerId];
    rebalanceVideoGrids();
}

document.getElementById("webrtc-toggle-mic").addEventListener("click", () => {
    if (!localStream) return;
    isMicMuted = !isMicMuted;
    localStream.getAudioTracks().forEach(track => track.enabled = !isMicMuted);
    
    const btn = document.getElementById("webrtc-toggle-mic");
    const icon = document.getElementById("webrtc-mic-icon");
    const text = document.getElementById("webrtc-mic-text");
    const badge = document.getElementById("local-mic-badge");

    if (isMicMuted) {
        btn.className = "btn btn-outline-danger btn-sm rounded-pill px-3 d-flex align-items-center gap-1.5";
        icon.className = "bi bi-mic-mute-fill";
        text.innerText = "Unmute";
        badge.classList.remove("d-none");
    } else {
        btn.className = "btn btn-outline-success btn-sm rounded-pill px-3 d-flex align-items-center gap-1.5 active";
        icon.className = "bi bi-mic-fill";
        text.innerText = "Mute";
        badge.classList.add("d-none");
    }

    if (currentRoom) {
        connection.invoke("UpdateMediaState", currentRoom, isMicMuted, isCameraOff).catch(e => console.log(e));
    }
});

document.getElementById("webrtc-toggle-cam").addEventListener("click", () => {
    if (!localStream) return;
    isCameraOff = !isCameraOff;
    localStream.getVideoTracks().forEach(track => track.enabled = !isCameraOff);

    const btn = document.getElementById("webrtc-toggle-cam");
    const icon = document.getElementById("webrtc-cam-icon");
    const text = document.getElementById("webrtc-cam-text");
    const videoEl = document.getElementById("local-video");
    const avatarEl = document.getElementById("local-video-avatar");

    if (isCameraOff) {
        btn.className = "btn btn-outline-danger btn-sm rounded-pill px-3 d-flex align-items-center gap-1.5";
        icon.className = "bi bi-camera-video-off-fill";
        text.innerText = "Camera On";
        videoEl.style.display = "none";
        avatarEl.style.display = "flex";
    } else {
        btn.className = "btn btn-outline-success btn-sm rounded-pill px-3 d-flex align-items-center gap-1.5 active";
        icon.className = "bi bi-camera-video-fill";
        text.innerText = "Camera Off";
        videoEl.style.display = "block";
        avatarEl.style.display = "none";
    }

    if (currentRoom) {
        connection.invoke("UpdateMediaState", currentRoom, isMicMuted, isCameraOff).catch(e => console.log(e));
    }
});

function cleanupWebRtc() {
    if (localStream) {
        localStream.getTracks().forEach(track => track.stop());
        localStream = null;
    }
    Object.keys(peerConnections).forEach(id => {
        if (peerConnections[id].iceRestartTimer) {
            clearTimeout(peerConnections[id].iceRestartTimer);
        }
        try { peerConnections[id].pc.close(); } catch (e) {}
        delete peerConnections[id];
    });
    Object.keys(earlyCandidatesQueue).forEach(id => delete earlyCandidatesQueue[id]);
    document.querySelectorAll(".remote-video-box").forEach(el => el.remove());
    rebalanceVideoGrids();
}
