connection.on("ReceiveWebRtcSignal", async (senderConnectionId, signalType, signalData) => {
    try {
        const payload = JSON.parse(signalData);
        if (signalType === "offer") {
            await handleWebRtcOffer(senderConnectionId, payload);
        } else if (signalType === "answer") {
            await handleWebRtcAnswer(senderConnectionId, payload);
        } else if (signalType === "ice-candidate") {
            await handleWebRtcCandidate(senderConnectionId, payload);
        }
    } catch (err) {
        console.error("Error handling WebRTC signal:", err);
    }
});

