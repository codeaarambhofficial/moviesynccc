function handleVideoSwitch(url, title, notifyServer = false, startTime = 0) {
    resetAllPlayers();

    const statusBadge = document.getElementById("stream-status-badge");
    const statusText = document.getElementById("stream-status-text");

    if (url && url.startsWith("screenshare://")) {
        const sharerConnectionId = url.replace("screenshare://", "");
        const cleanName = title || "Screen Share";
        const titleEl = document.getElementById("active-video-title");
        if (titleEl) titleEl.innerText = cleanName;

        if (statusBadge && statusText) {
            statusBadge.className = "status-badge-custom status-range";
            statusText.innerText = "Live Screen Share Active";
        }

        if (sharerConnectionId === connection.connectionId) {
            // I am the screensharer
            html5Player.style.display = "block";
            if (screenShareStream) {
                html5Player.srcObject = screenShareStream;
                html5Player.play().catch(e => console.log("Screenshare local play caught:", e));
            }
        } else {
            // Remote peer is the screensharer
            html5Player.style.display = "block";
            const peerObj = peerConnections[sharerConnectionId];
            if (peerObj && peerObj.screenShareStream) {
                html5Player.srcObject = peerObj.screenShareStream;
                html5Player.play().catch(e => console.log("Screenshare remote play caught:", e));
            } else {
                html5Player.srcObject = null;
                const promptOverlay = document.getElementById("local-file-prompt-overlay");
                const promptText = document.getElementById("local-prompt-text");
                if (promptText) {
                    promptText.innerText = `Waiting for ${cleanName}'s screenshare stream to resolve over WebRTC...`;
                }
                if (promptOverlay) promptOverlay.classList.remove("d-none");
            }
        }
        toggleLoading(false);
        return;
    }

    const isLocalProtocol = !url || url.startsWith("local://") || url.startsWith("blob:");

    if (isLocalProtocol) {
        const cleanName = title || (url ? url.replace("local://", "") : "Local Movie");
        const titleEl = document.getElementById("active-video-title");
        if (titleEl) titleEl.innerText = cleanName;

        if (activeBlobUrl) {
            // User HAS selected their local video file!
            html5Player.style.display = "block";
            const promptOverlay = document.getElementById("local-file-prompt-overlay");
            if (promptOverlay) promptOverlay.classList.add("d-none");

            if (html5Player.src !== activeBlobUrl) {
                html5Player.src = activeBlobUrl;
            }
            if (startTime > 0) {
                html5Player.currentTime = startTime;
            }
            const hostIsPlaying = lastReceivedState?.isPlaying !== undefined ? lastReceivedState.isPlaying : lastReceivedState?.IsPlaying;
            if (hostIsPlaying) {
                html5Player.play().catch(e => console.log("Autoplay caught on local switch:", e));
            }
        } else {
            // User HAS NOT selected local video file yet!
            html5Player.style.display = "none";
            const promptOverlay = document.getElementById("local-file-prompt-overlay");
            const promptText = document.getElementById("local-prompt-text");
            if (promptText) {
                promptText.innerText = `Room movie is set to "${cleanName}". Select your local video file to join synchronized watch!`;
            }
            if (promptOverlay) promptOverlay.classList.remove("d-none");
        }
        toggleLoading(false);
        return;
    }

    // External streams or internal HLS / Range streams
    const ytId = extractYtId(url);

    if (ytId) {
        if (statusBadge && statusText) {
            statusBadge.className = "status-badge-custom status-yt";
            statusText.innerText = "YouTube Stream";
        }
        const wrapper = getYtWrapper();
        if (wrapper) wrapper.style.display = "block";
        if (isPlayerReady && ytPlayer && typeof ytPlayer.loadVideoById === 'function') {
            ytPlayer.loadVideoById({ 'videoId': ytId, 'startSeconds': startTime });
        } else {
            pendingVideo = { url: url, title: title, startTime: startTime };
        }
    } else if (url.includes("/hls/") || url.match(/\.m3u8($|\?)/i)) {
        html5Player.style.display = "block";
        if (statusBadge && statusText) {
            statusBadge.className = "status-badge-custom status-hls";
            statusText.innerText = "HLS Adaptive Stream Active";
        }

        if (Hls.isSupported()) {
            hlsInstance = new Hls({
                maxBufferLength: 30,
                maxMaxBufferLength: 60,
                maxBufferSize: 60 * 1024 * 1024,
                backBufferLength: 30,
                enableWorker: true,
                lowLatencyMode: false,
                fragLoadingTimeOut: 20000,
                fragLoadingMaxRetry: 6,
                fragLoadingRetryDelay: 1000
            });

            hlsInstance.loadSource(url);
            hlsInstance.attachMedia(html5Player);

            hlsInstance.on(Hls.Events.MANIFEST_PARSED, (event, data) => {
                if (startTime > 0) html5Player.currentTime = startTime;
                updateTrackDropdowns(data.audioTracks, data.subtitleTracks);
                const hostIsPlaying = lastReceivedState?.isPlaying !== undefined ? lastReceivedState.isPlaying : lastReceivedState?.IsPlaying;
                if (hostIsPlaying) {
                    html5Player.play().catch(e => console.log("HLS play caught:", e));
                }
            });

            hlsInstance.on(Hls.Events.ERROR, (event, data) => {
                if (data.fatal) {
                    switch (data.type) {
                        case Hls.ErrorTypes.NETWORK_ERROR:
                            console.log("HLS network error, retrying...");
                            hlsInstance.startLoad();
                            break;
                        case Hls.ErrorTypes.MEDIA_ERROR:
                            console.log("HLS media error, recovering...");
                            hlsInstance.recoverMediaError();
                            break;
                        default:
                            console.log("HLS fatal error, falling back to progressive range stream...");
                            if (hlsInstance) {
                                hlsInstance.destroy();
                                hlsInstance = null;
                            }
                            const fallbackUrl = url.replace('/hls/', '/play/').replace('/playlist.m3u8', '');
                            html5Player.src = fallbackUrl;
                            if (startTime > 0) html5Player.currentTime = startTime;
                            html5Player.play().catch(e => console.log("Fallback play caught:", e));
                            break;
                    }
                }
            });
        } else if (html5Player.canPlayType('application/vnd.apple.mpegurl')) {
            html5Player.src = url;
            if (startTime > 0) html5Player.currentTime = startTime;
        }
    } else if (url.match(/\.(mp4|mkv|webm|avi|mov|ogg)(\?.*)?$/i) || url.includes('/api/stream/')) {
        html5Player.style.display = "block";
        if (statusBadge && statusText) {
            statusBadge.className = "status-badge-custom status-range";
            statusText.innerText = "Range Request Media Stream";
        }
        html5Player.src = url;
        if (startTime > 0) html5Player.currentTime = startTime;
        html5Player.play().catch(e => console.log("Autoplay caught:", e));
    } else {
        iframePlayer.style.display = "block";
        iframePlayer.src = url;
    }

    const titleEl = document.getElementById("active-video-title");
    if (titleEl) titleEl.innerText = title || "MovieSync Stream";

    toggleLoading(false);
}

function getPlayerCurrentTime() {
    if (isYtActive() && isPlayerReady && ytPlayer && typeof ytPlayer.getCurrentTime === 'function') {
        return ytPlayer.getCurrentTime() || 0;
    } else if (html5Player && html5Player.style.display !== "none") {
        return html5Player.currentTime || 0;
    }
    return 0;
}

function seekPlayerTo(time) {
    if (isYtActive() && isPlayerReady && ytPlayer && typeof ytPlayer.seekTo === 'function') {
        ytPlayer.seekTo(time, true);
    } else if (html5Player && html5Player.style.display !== "none") {
        html5Player.currentTime = time;
    }
}

function startPlayerPlayback() {
    if (isYtActive() && isPlayerReady && ytPlayer && typeof ytPlayer.playVideo === 'function') {
        ytPlayer.playVideo();
        return Promise.resolve();
    } else if (html5Player && html5Player.style.display !== "none") {
        return html5Player.play().catch(err => console.log("HTML5 play error:", err));
    }
    return Promise.resolve();
}

function pausePlayerPlayback() {
    if (isYtActive() && isPlayerReady && ytPlayer && typeof ytPlayer.pauseVideo === 'function') {
        ytPlayer.pauseVideo();
    } else if (html5Player && html5Player.style.display !== "none") {
        html5Player.pause();
    }
}

function isPlayerActuallyPlaying() {
    if (isYtActive() && isPlayerReady && ytPlayer && typeof ytPlayer.getPlayerState === 'function') {
        return ytPlayer.getPlayerState() === YT.PlayerState.PLAYING;
    } else if (html5Player && html5Player.style.display !== "none") {
        return !html5Player.paused;
    }
    return false;
}

function getEstimatedHostTime() {
    if (lastReceivedState) {
        const baseTime = lastReceivedState.currentTime || lastReceivedState.CurrentTime || 0;
        const updatedAt = lastReceivedState.lastUpdated || lastReceivedState.LastUpdated || Date.now();
        const isPlaying = lastReceivedState.isPlaying !== undefined ? lastReceivedState.isPlaying : lastReceivedState.IsPlaying;
        if (isPlaying) {
            const elapsed = (Date.now() - new Date(updatedAt).getTime()) / 1000;
            return baseTime + Math.max(0, elapsed);
        }
        return baseTime;
    }
    return getPlayerCurrentTime();
}

function checkDriftAndStateSync() {
    if (!currentRoom) return;
    const playerTime = getPlayerCurrentTime();
    const isPlayingLocally = isPlayerActuallyPlaying();
    
    if (isHost) {
        if (isPlayingLocally) {
            const rate = (html5Player && html5Player.style.display !== "none") ? html5Player.playbackRate : 1.0;
            connection.invoke("SyncPosition", currentRoom, playerTime, rate).catch(err => console.log("SyncPosition error:", err));
        }
    } else if (!isHost && lastReceivedState) {
        const hostIsPlaying = lastReceivedState.isPlaying !== undefined ? lastReceivedState.isPlaying : lastReceivedState.IsPlaying;
        const hostTime = getEstimatedHostTime();

        const isMediaActive = (html5Player && html5Player.style.display !== "none" && activeBlobUrl) ||
                              isYtActive();

        if (isMediaActive) {
            // Play/Pause state sync
            if (hostIsPlaying && !isPlayingLocally) {
                startPlayerPlayback();
            } else if (!hostIsPlaying && isPlayingLocally) {
                pausePlayerPlayback();
            }

            // Seek / Drift sync
            if (playerTime !== null && playerTime !== undefined) {
                const difference = hostTime - playerTime;
                const absDiff = Math.abs(difference);

                if (absDiff >= 1.0) {
                    seekPlayerTo(hostTime);
                    if (html5Player && html5Player.style.display !== "none") html5Player.playbackRate = 1.0;
                } else if (absDiff >= 0.15) {
                    if (html5Player && html5Player.style.display !== "none") {
                        html5Player.playbackRate = difference > 0 ? 1.03 : 0.97;
                    }
                } else {
                    if (html5Player && html5Player.style.display !== "none") {
                        html5Player.playbackRate = 1.0;
                    }
                }
            }
        }
    }
}

