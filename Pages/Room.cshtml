    const btnText = document.getElementById("screen-share-btn-text");
    const icon = document.getElementById("screen-share-icon");
    const statusBadge = document.getElementById("screen-share-status");
    const html5Player = document.getElementById("html5-player");
    const youtubeWrapper = document.getElementById("youtube-player-wrapper");
    const iframePlayer = document.getElementById("iframe-player");

    if (!isScreenSharing) {
        try {
            screenShareStream = await navigator.mediaDevices.getDisplayMedia({
                video: { cursor: "always" },
                audio: true
            });

            isScreenSharing = true;

            // Hide YouTube & IFrame, Show HTML5 Video Player with Screen Stream
            if (youtubeWrapper) youtubeWrapper.style.display = "none";
            if (iframePlayer) iframePlayer.style.display = "none";
            if (html5Player) {
                html5Player.style.display = "block";
                html5Player.srcObject = screenShareStream;
                html5Player.play().catch(e => console.log(e));
            }

            if (btn) btn.className = "btn btn-danger px-4 py-2.5 rounded-pill shadow-sm fw-semibold d-flex align-items-center gap-2";
            if (icon) icon.className = "bi bi-stop-circle-fill";
            if (btnText) btnText.innerText = "Stop Screen Share";
            if (statusBadge) statusBadge.classList.remove("d-none");

            const titleEl = document.getElementById("active-video-title");
            const statusTextEl = document.getElementById("stream-status-text");
            if (titleEl) titleEl.innerText = "Live Screen Share Broadcast";
            if (statusTextEl) statusTextEl.innerText = "Screen Share Active";

            showToast("success", "Screen share started successfully 🖥️");

            // Attach screenshare tracks to all existing peer connections
            Object.keys(peerConnections).forEach(id => {
                const pc = peerConnections[id].pc;
                const senders = [];
                screenShareStream.getTracks().forEach(track => {
                    try {
                        const sender = pc.addTrack(track, screenShareStream);
                        senders.push(sender);
                    } catch (e) {
                        console.warn("[WebRTC Track] Error adding screen track to pc:", e);
                    }
                });
                screenShareSenders[id] = senders;
            });

            // Signal the video change to screenshare
            const username = document.getElementById("username-input")?.value || "Someone";
            if (currentRoom) {
                await connection.invoke("ChangeVideo", currentRoom, "screenshare://" + connection.connectionId, `Screen Share - ${username}`, 0.0);
            }

            screenShareStream.getVideoTracks()[0].onended = () => {
                stopScreenShare();
            };
        } catch (err) {
            console.warn("Screen share cancelled or failed:", err);
            showToast("info", "Screen share cancelled.");
        }
    } else {
        stopScreenShare();
    }
}

function stopScreenShare() {
    const btn = document.getElementById("start-screen-share-btn");
    const btnText = document.getElementById("screen-share-btn-text");
    const icon = document.getElementById("screen-share-icon");
    const statusBadge = document.getElementById("screen-share-status");
    const html5Player = document.getElementById("html5-player");

    isScreenSharing = false;
    if (screenShareStream) {
        screenShareStream.getTracks().forEach(track => track.stop());
        screenShareStream = null;
    }

    // Remove screenshare tracks from all active peer connections
    Object.keys(peerConnections).forEach(id => {
        const pc = peerConnections[id].pc;
        if (screenShareSenders[id]) {
            screenShareSenders[id].forEach(sender => {
                try {
                    pc.removeTrack(sender);
                } catch (e) {
                    console.warn("[WebRTC Track] Error removing screen track from pc:", e);
                }
            });
            delete screenShareSenders[id];
        }
    });

    if (html5Player) {
        html5Player.srcObject = null;
    }

    if (btn) {
        btn.className = "btn btn-info px-4 py-2.5 rounded-pill shadow-sm fw-semibold d-flex align-items-center gap-2";
    }
    if (icon) icon.className = "bi bi-display-fill";
    if (btnText) btnText.innerText = "Start Screen Share";
    if (statusBadge) statusBadge.classList.add("d-none");

    const titleEl = document.getElementById("active-video-title");
    const statusTextEl = document.getElementById("stream-status-text");
    if (titleEl) titleEl.innerText = "No Stream Active";
    if (statusTextEl) statusTextEl.innerText = "Idle";
    showToast("info", "Screen share stopped.");

    // Signal the video change to idle/empty
    if (currentRoom) {
        connection.invoke("ChangeVideo", currentRoom, "", "No Stream Active", 0.0).catch(e => console.log(e));
    }
}

function displayRemoteScreenShare(stream) {
    if (html5Player) {
        html5Player.srcObject = stream;
        html5Player.style.display = "block";
