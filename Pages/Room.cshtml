async function uploadAndStreamFile(file) {
    try {
        const badge = document.getElementById("selected-file-badge");
        const nameEl = document.getElementById("selected-file-name");
        if (badge && nameEl) {
            nameEl.innerText = `Preparing media stream... (0%)`;
            badge.classList.remove("d-none");
        }

        const initRes = await fetch('/api/stream/init-chunked', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ fileName: file.name, roomId: currentRoom })
        });

        if (!initRes.ok) throw new Error("Failed to initialize stream session");
        const { streamId } = await initRes.json();

        // Broadcast HLS stream URL to participants
        const streamUrl = `/api/stream/hls/${streamId}/playlist.m3u8`;
        connection.invoke("ChangeVideo", currentRoom, streamUrl, file.name, html5Player.currentTime || 0.0);

        const chunkSize = 2 * 1024 * 1024; // 2MB chunk
        const totalChunks = Math.ceil(file.size / chunkSize);

        for (let i = 0; i < totalChunks; i++) {
            const start = i * chunkSize;
            const end = Math.min(file.size, start + chunkSize);
            const chunk = file.slice(start, end);
            const isLast = (i === totalChunks - 1);

            const formData = new FormData();
            formData.append("streamId", streamId);
            formData.append("isLast", isLast ? "true" : "false");
            formData.append("file", chunk, file.name);

            const uploadRes = await fetch('/api/stream/upload-chunk', {
                method: 'POST',
                body: formData
            });

            if (!uploadRes.ok) {
                console.warn(`Chunk ${i} upload status warning`);
            }

            const pct = Math.round(((i + 1) / totalChunks) * 100);
            if (nameEl) nameEl.innerText = `Streaming to room... (${pct}%)`;
        }

        if (nameEl) nameEl.innerText = `Live Stream Active: ${file.name}`;
        showToast("success", "Media streaming active for all room participants!");
    } catch (err) {
        console.error("uploadAndStreamFile error:", err);
        showToast("error", "Stream upload error: " + err.message);
    }
}

function loadLocalFileStream(blobUrl, fileName, fileSize = 0) {
    toggleLoading(true, "Loading Local Video...");

    activeVideoUrl = blobUrl;
    activeVideoTitle = fileName;
    activeBlobUrl = blobUrl;

    const promptOverlay = document.getElementById("local-file-prompt-overlay");
    if (promptOverlay) promptOverlay.classList.add("d-none");

    const wrapper = getYtWrapper();
    if (wrapper) wrapper.style.display = "none";
    if (iframePlayer) iframePlayer.style.display = "none";
    html5Player.style.display = "block";
    html5Player.src = blobUrl;

    const titleEl = document.getElementById("active-video-title");
    if (titleEl) titleEl.innerText = fileName;

    toggleLoading(false);

    if (currentRoom) {
        connection.invoke("SelectLocalMedia", currentRoom, fileName, fileSize).catch(err => console.log("SelectLocalMedia error:", err));
        if (isHost) {
            connection.invoke("ChangeVideo", currentRoom, "local://" + fileName, fileName, 0.0);
        } else {
            // Non-host: sync immediately to estimated host position and play state
            const estTime = getEstimatedHostTime();
            if (estTime > 0) {
                html5Player.currentTime = estTime;
            }
            const hostIsPlaying = lastReceivedState?.isPlaying !== undefined ? lastReceivedState.isPlaying : lastReceivedState?.IsPlaying;
            if (hostIsPlaying) {
                html5Player.play().catch(e => console.log("Autoplay caught on loadLocalFileStream:", e));
            }
        }
    }
    showToast("success", `Loaded local video: ${fileName}`);
}

document.getElementById("load-video-btn").addEventListener("click", () => {
