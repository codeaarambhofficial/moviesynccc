@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5 min-vh-75" style="max-width: 800px;">
    <div class="glass-panel p-5">
        <h1 class="fw-bold tracking-tight bg-gradient-text mb-4">@ViewData["Title"]</h1>
        <p class="text-muted leading-relaxed">Use this page to detail your site's privacy policy. All connection logging, room activities, and message logs on MovieSync are ephemeral and reside strictly in application memory. No video viewing behaviors or chat logs are permanently recorded, maintaining total privacy for you and your guests.</p>
    </div>
</div>
